   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12587">
      <skos:prefLabel xml:lang="en">methanisation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process of deriving methane from any source, including livestock manure, landfills, coal mines, etc.</skos:scopeNote>
