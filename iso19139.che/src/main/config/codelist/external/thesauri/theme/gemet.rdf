      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7276"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8307">
      <skos:prefLabel xml:lang="en">tax</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An amount of money demanded by a government for its support or for specific facilities or services, most frequently levied upon income, property or sales.</skos:scopeNote>
