      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9121"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9062">
      <skos:prefLabel xml:lang="en">waste disposal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The orderly process of discarding unwanted or useless material.</skos:scopeNote>
