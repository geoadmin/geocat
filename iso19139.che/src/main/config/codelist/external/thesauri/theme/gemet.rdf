   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3884">
      <skos:prefLabel xml:lang="en">hearing impairment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A decrease in strength or any abnormality or partial or complete loss of hearing or of the function of ear, or hearing system, due directly  or secondarily to pathology or injury; it may be either temporary or permanent.</skos:scopeNote>
