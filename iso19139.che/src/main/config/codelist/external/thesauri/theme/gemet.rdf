      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6710"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6268">
      <skos:prefLabel xml:lang="en">pinniped</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Belonging to the Pinnipedia, an order of aquatic placental mammals having a streamlined body and limbs specialized as flippers: includes seals, sea lions, and the walrus.</skos:scopeNote>
