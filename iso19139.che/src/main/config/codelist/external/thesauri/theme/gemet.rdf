      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7176"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7179">
      <skos:prefLabel xml:lang="en">respiratory disease</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">maladie respiratoire</skos:prefLabel>
