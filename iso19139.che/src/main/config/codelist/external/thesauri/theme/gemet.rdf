   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12382">
      <skos:prefLabel xml:lang="en">metal waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Metal material discarded during manufacturing or processing operations which cannot be directly fed back into the operation; Worn or discarded metal materials removed from service at the end of its useful life.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchet métallique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuto metallico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">metaalafval</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Altmetall</skos:prefLabel>
