   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6540">
      <skos:prefLabel xml:lang="en">potash</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any of several compounds containing potassium, especially soluble compounds such as potassium oxide, potassium chloride, and various potassium sulfates, used chiefly in fertilizers.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">potasse</skos:prefLabel>
      <skos:prefLabel xml:lang="it">potassa</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">potas</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Pottasche</skos:prefLabel>
