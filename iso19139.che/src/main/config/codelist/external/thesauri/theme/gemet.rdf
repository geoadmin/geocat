      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9058">
      <skos:prefLabel xml:lang="en">waste conversion technique</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any specialized procedure or method used to transform refuse from one state, form or chemical composition into another.</skos:scopeNote>
