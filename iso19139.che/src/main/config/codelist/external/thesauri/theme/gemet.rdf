      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1191"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8866">
      <skos:prefLabel xml:lang="en">scrap tyre</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Recyclable material from discarded motor vehicle tyres.</skos:scopeNote>
