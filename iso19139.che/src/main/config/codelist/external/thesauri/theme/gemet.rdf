      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11472"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7999">
      <skos:prefLabel xml:lang="en">spider</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any predatory silk-producing arachnid of the order Araneae, having four pairs of legs and a rounded unsegmented body consisting of abdomen and cephalothorax.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">araignée</skos:prefLabel>
      <skos:prefLabel xml:lang="it">ragni</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">spinnen</skos:prefLabel>
