      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/1446"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/664">
      <skos:prefLabel xml:lang="en">autoecology</skos:prefLabel>
      <skos:scopeNote xml:lang="en">That part of ecology which deals with individual species and their reactions to environmental factors.</skos:scopeNote>
