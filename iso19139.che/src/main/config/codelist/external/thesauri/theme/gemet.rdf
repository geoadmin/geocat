   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12450">
      <skos:prefLabel xml:lang="en">industrial activity</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Operations, functions and processes involved in industrial production.</skos:scopeNote>
