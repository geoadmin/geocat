   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3823">
      <skos:prefLabel xml:lang="en">halogenated terphenyl</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">terphenyl halogéné</skos:prefLabel>
      <skos:prefLabel xml:lang="it">terfenili alogenati</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">halogeenterphenyl</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Halogenierte Terphenyle</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/6"/>
