   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7690">
      <skos:prefLabel xml:lang="en">sieving</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The size distribution of solid particles on a series of standard sieves of decreasing size, expressed as a weight percent.</skos:scopeNote>
