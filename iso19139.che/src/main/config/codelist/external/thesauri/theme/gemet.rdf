      <skos:prefLabel xml:lang="nl">burgerinitiatief</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bürgerinitiative</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/34"/>
