      <skos:prefLabel xml:lang="it">legislazione sull'acqua di rifiuto</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">afvalwaterwetgeving</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Abwasserrecht</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/21"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
