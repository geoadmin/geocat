      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15076"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15267">
      <skos:prefLabel xml:lang="en">product environmental footprint</skos:prefLabel>
      <skos:scopeNote xml:lang="en">result of a Product Environmental Footprint study based on the Product Environmental Footprint method</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
