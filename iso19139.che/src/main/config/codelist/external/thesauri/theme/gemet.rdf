   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5090">
      <skos:prefLabel xml:lang="en">material life cycle</skos:prefLabel>
      <skos:scopeNote xml:lang="en">All the stages involved in the manufacturing, distribution and retail, use and re-use and maintenance, recycling and waste management of materials.</skos:scopeNote>
