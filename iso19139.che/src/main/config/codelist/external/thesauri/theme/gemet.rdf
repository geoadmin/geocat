      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7191"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2014">
      <skos:prefLabel xml:lang="en">decomposition</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The more or less permanent breakdown of a molecule into simpler molecules or atoms.</skos:scopeNote>
