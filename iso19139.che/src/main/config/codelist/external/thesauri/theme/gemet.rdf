      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4629"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4187">
      <skos:prefLabel xml:lang="en">income</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The gain derived from capital, from labour or effort, or both combined, including profit or gain through sale or conversion of capital.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">revenu</skos:prefLabel>
      <skos:prefLabel xml:lang="it">reddito</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">inkomen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Einkommen</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/9"/>
