   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3174">
      <skos:prefLabel xml:lang="en">fibre</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An extremely long, pliable, cohesive natural or manufactured threadlike object from which yarns are spun to be woven into textiles.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">fibre</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fibra</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vezel</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Faser</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/27"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4260"/>
