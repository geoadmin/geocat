   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7352">
      <skos:prefLabel xml:lang="en">rural population</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The total number of persons inhabiting an agricultural or pastoral region.</skos:scopeNote>
