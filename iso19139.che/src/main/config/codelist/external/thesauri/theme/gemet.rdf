   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4290">
      <skos:prefLabel xml:lang="en">infestation of food</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Food that has been contaminated and deteriorated by some kind of pest.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">infestation des aliments</skos:prefLabel>
      <skos:prefLabel xml:lang="it">infestazione di alimenti</skos:prefLabel>
