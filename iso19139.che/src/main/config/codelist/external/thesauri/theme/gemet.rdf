   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4571">
      <skos:prefLabel xml:lang="en">laboratory experiment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Tests or investigations carried out in a laboratory.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">expérience de laboratoire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">esperimento di laboratorio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">laboratoriumexperiment</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Laborversuch</skos:prefLabel>
