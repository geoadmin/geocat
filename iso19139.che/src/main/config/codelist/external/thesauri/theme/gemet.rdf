   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2570">
      <skos:prefLabel xml:lang="en">efficiency level</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The ratio of output to input, usually given as a percentage.</skos:scopeNote>
