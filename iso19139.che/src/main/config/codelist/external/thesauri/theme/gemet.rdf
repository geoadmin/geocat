      <skos:prefLabel xml:lang="it">divieto di scarico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">verbod op de verspreiding van afvalwater</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Aufbringungsverbot</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/21"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/39"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
