   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1182">
      <skos:prefLabel xml:lang="en">carcinogen</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A substance that causes cancer in humans and animals.</skos:scopeNote>
