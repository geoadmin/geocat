   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9133">
      <skos:prefLabel xml:lang="en">waste water legislation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A binding rule or body of rules prescribed by a government to regulate the outflow and disposal of spent or used water from a home, community, farm or industry that contains dissolved or suspended matter.</skos:scopeNote>
