      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/1762"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8664">
      <skos:prefLabel xml:lang="en">tree</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any large woody perennial plant with a distinct trunk giving rise to branches or leaves at some distance from the ground.</skos:scopeNote>
