   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9128">
      <skos:prefLabel xml:lang="en">waste water charge</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Imposed fee, expense, or cost for the management of spent or used water that contains dissolved or suspended matter from a home, community farm, or industry.</skos:scopeNote>
