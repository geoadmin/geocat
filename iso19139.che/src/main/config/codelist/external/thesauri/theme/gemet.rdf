   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15184">
      <skos:prefLabel xml:lang="en">genetic material</skos:prefLabel>
      <skos:scopeNote xml:lang="en">genes and other hereditary material in any biological material that can be transferred to other organisms with or without the help of technology, except for human genetic material</skos:scopeNote>
