   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/289">
      <skos:prefLabel xml:lang="en">air transportation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The use of aircraft, predominantly airplanes, to move passengers and cargo.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">transport aérien</skos:prefLabel>
      <skos:prefLabel xml:lang="it">trasporto aereo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">luchtvervoer</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lufttransport</skos:prefLabel>
