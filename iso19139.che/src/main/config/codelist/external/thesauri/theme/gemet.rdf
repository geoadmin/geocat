   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13221">
      <skos:prefLabel xml:lang="en">audiovisual equipment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Equipment designed to aid in learning and teaching by making use of both hearing and sight.</skos:scopeNote>
