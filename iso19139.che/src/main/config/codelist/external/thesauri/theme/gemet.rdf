      <skos:prefLabel xml:lang="it">pompa di calore</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">warmtepomp</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wärmepumpe</skos:prefLabel>
