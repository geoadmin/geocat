   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11763">
      <skos:prefLabel xml:lang="en">intoxication</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The state of being poisoned; the condition produced by a poison which may be swallowed, inhaled, injected, or absorbed through the skin.</skos:scopeNote>
