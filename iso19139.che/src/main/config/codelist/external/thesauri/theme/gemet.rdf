   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8845">
      <skos:prefLabel xml:lang="en">urban study</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The study and theory of building and other physical needs in cities or predominantly urban cultures.</skos:scopeNote>
