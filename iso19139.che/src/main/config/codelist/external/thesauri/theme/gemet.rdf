      <skos:prefLabel xml:lang="it">zona d'intervento fondiario</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">landbeheerinterventiegebied</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Eingriff in die Raumordnung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/11"/>
