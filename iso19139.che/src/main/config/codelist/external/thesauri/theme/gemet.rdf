   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11375">
      <skos:prefLabel xml:lang="en">building restoration</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The accurate reestablishment of the form and details of a building, its artifacts, and the site on which it is located, usually as it appeared at a particular time.</skos:scopeNote>
