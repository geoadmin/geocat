   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/693">
      <skos:prefLabel xml:lang="en">background level</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Term used in a variety of situations, always as the constant or natural amount of a given substance, radiation, noise, etc.</skos:scopeNote>
