   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1180">
      <skos:prefLabel xml:lang="en">carcinogenicity</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The ability or tendency of a substance or physical agent to cause or produce cancer.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">cancérigènicité</skos:prefLabel>
      <skos:prefLabel xml:lang="it">cancerogenicità</skos:prefLabel>
