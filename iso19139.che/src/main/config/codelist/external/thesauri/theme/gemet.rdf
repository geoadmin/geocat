   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8595">
      <skos:prefLabel xml:lang="en">traffic monitoring</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The periodic or continuous surveillance or analysis of the movement of persons, objects, vehicles or other conveyances along an area of passage.</skos:scopeNote>
