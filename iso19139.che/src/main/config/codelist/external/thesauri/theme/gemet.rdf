   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6280">
      <skos:prefLabel xml:lang="en">plane source</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Pollution which arises from various activities with no discrete source.</skos:scopeNote>
