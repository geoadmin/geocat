   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9140">
      <skos:prefLabel xml:lang="en">waste water sludge</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The removed materials resulting from physical, biological and chemical treatment of waste water.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">boues résiduaires de traitement des eaux</skos:prefLabel>
