      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1824"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1827">
      <skos:prefLabel xml:lang="en">cotton</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The most economical natural fiber, obtained from plants of the genus Gossypium, used in making fabrics, cordage, and padding and for producing artificial fibers and cellulose.</skos:scopeNote>
