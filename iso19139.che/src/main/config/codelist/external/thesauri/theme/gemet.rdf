   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8371">
      <skos:prefLabel xml:lang="en">temporary storage</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any deposit or holdings of goods, materials or waste in a facility, container, tank or some other physical location for a brief or short time period.</skos:scopeNote>
