      <skos:prefLabel xml:lang="it">scienze esatte</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">exacte wetenschap(pen)</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Exakte Wissenschaft</skos:prefLabel>
