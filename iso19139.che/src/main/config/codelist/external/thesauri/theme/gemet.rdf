   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4952">
      <skos:prefLabel xml:lang="en">machine manufacture</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The making or production of mechanical apparatuses used for commercial or industrial purposes, such as engines and turbines, elevators and conveying equipment, computers and office equipment, and hoists, cranes and industrial trucks.</skos:scopeNote>
