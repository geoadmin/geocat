      <skos:prefLabel xml:lang="it">bifenili alogenati</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">halogeenbifenyl</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Halogenbiphenyle</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/6"/>
