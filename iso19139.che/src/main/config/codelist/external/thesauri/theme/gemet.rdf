   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/229">
      <skos:prefLabel xml:lang="en">agricultural waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Unusable materials, liquid or solid, that result from agricultural practices, such as fertilizers, pesticides, crop residue (such as orchard prunings) and cattle manure.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchet agricole</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuto agricolo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">landbouwafval</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Landwirtschaftlicher Abfall</skos:prefLabel>
