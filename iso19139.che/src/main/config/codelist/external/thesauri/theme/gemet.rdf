   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1466">
      <skos:prefLabel xml:lang="en">climate protection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Precautionary actions, procedures or installations undertaken to prevent or reduce harm from pollution to natural weather conditions or patterns, including the prevailing temperature, atmospheric composition and precipitation.</skos:scopeNote>
