   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3890">
      <skos:prefLabel xml:lang="en">heat (physics)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A form of energy that is transferred by a difference in temperature: it is equal to the total kinetic energy of the atoms or molecules of a system.</skos:scopeNote>
