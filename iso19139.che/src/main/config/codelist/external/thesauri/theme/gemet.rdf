   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7345">
      <skos:prefLabel xml:lang="en">rural area</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Area outside the limits of any incorporated or unincorporated city, town, village, or any other designated residential or commercial area such as a subdivision, a business or shopping center, or community development.</skos:scopeNote>
