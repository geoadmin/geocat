   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8386">
      <skos:prefLabel xml:lang="en">terrestrial area</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Subdivisions of the continental surfaces distinguished from one another on the basis of the form, roughness, and surface composition of the land.</skos:scopeNote>
