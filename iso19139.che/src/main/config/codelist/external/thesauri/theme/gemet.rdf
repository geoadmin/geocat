      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6517"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13327">
      <skos:prefLabel xml:lang="en">composition of population</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The constituent groupings and proportions of the total inhabitants of a given nation, area, region or city, as seen from various perspectives.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">composition de la population</skos:prefLabel>
      <skos:prefLabel xml:lang="it">composizione della popolazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">samenstelling van de bevolking</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bevölkerungsaufbau</skos:prefLabel>
