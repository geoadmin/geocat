      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5829"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3512">
      <skos:prefLabel xml:lang="en">fuel oil</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A liquid product burned to generate heat, exclusive of oils with a flash point below 38°C; includes heating oils, stove oils, furnace oils, bunker fuel oils.</skos:scopeNote>
