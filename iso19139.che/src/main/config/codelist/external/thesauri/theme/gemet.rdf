   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7707">
      <skos:prefLabel xml:lang="en">sintering</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Forming a coherent bonded mass by heating metal powders without melting, used mostly in powder metallurgy.</skos:scopeNote>
