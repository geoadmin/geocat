      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15150"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8987">
      <skos:prefLabel xml:lang="en">viticulture</skos:prefLabel>
      <skos:scopeNote xml:lang="en">That division of horticulture concerned with grape growing, studies of grape varieties, methods of culture, and insect and disease control.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">viticulture</skos:prefLabel>
      <skos:prefLabel xml:lang="it">viticoltura</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">wijnbouw</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Weinbau</skos:prefLabel>
