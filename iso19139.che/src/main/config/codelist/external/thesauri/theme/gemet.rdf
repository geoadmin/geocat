   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4231">
      <skos:prefLabel xml:lang="en">industrial emission</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Gas-borne pollutants discharged into the atmosphere from smokestacks of industrial plants.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">émissions industrielles</skos:prefLabel>
      <skos:prefLabel xml:lang="it">emissioni industriali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">industrie-uitstoot</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Industrieemission</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/19"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/26"/>
