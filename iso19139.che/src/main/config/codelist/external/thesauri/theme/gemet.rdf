   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9149">
      <skos:prefLabel xml:lang="en">biological water balance</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The amount of ingoing and outgoing water in a system, which are assumed to be equal in the long term so that the water budget will balance.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">bilan hydrologique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">bilancio idrico biologico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">biologische waterbalans</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wasserhaushalt</skos:prefLabel>
