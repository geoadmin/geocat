   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13217">
      <skos:prefLabel xml:lang="en">preparation for market</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The containment, protection, handling and presentation of goods for the market.</skos:scopeNote>
