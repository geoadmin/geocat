   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9044">
      <skos:prefLabel xml:lang="en">waste analysis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An investigation carried out to decide what arrangements are appropriate for dealing with different kinds of wastes.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">analyse des déchets</skos:prefLabel>
      <skos:prefLabel xml:lang="it">analisi dei rifiuti</skos:prefLabel>
