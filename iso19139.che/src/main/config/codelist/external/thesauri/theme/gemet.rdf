   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7119">
      <skos:prefLabel xml:lang="en">reprocessing</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Restoration of contaminated nuclear fuel to a usable condition.</skos:scopeNote>
