   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9230">
      <skos:prefLabel xml:lang="en">water saving</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Management of water resources aiming at ensuring the continued availability of water for human uses and natural ecosystems.</skos:scopeNote>
