      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7554"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8405">
      <skos:prefLabel xml:lang="en">test</skos:prefLabel>
      <skos:scopeNote xml:lang="en">To carry out an examination on (a substance, material, or system) by applying some chemical or physical procedure designed to indicate the presence of a substance or the possession of a property.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">test</skos:prefLabel>
      <skos:prefLabel xml:lang="it">test</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">test</skos:prefLabel>
