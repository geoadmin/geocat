      <skos:prefLabel xml:lang="it">tendenza della popolazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">bevolkingstrend</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bevölkerungsentwicklung</skos:prefLabel>
