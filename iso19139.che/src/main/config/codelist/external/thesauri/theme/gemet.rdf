      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6485"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11752">
      <skos:prefLabel xml:lang="en">asbestosis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A non-malignant progressive, irreversible, lung disease, characterized by diffuse fibrosis, resulting from the inhalation of asbestos fibers.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">asbestose</skos:prefLabel>
      <skos:prefLabel xml:lang="it">asbestosi</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">asbestose</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Asbestose</skos:prefLabel>
