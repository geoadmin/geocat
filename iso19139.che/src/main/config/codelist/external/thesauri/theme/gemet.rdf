   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15264">
      <skos:prefLabel xml:lang="en">pollution reduction</skos:prefLabel>
      <skos:scopeNote xml:lang="en">lowering of pollutant releases into the environment measured on the basis of validated information subsequently published in a pollutant release inventory</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/26"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/11070"/>
