      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8803"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2117">
      <skos:prefLabel xml:lang="en">desk study</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">étude de bureau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">studio compilativo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">kantoorstudie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bürostudie</skos:prefLabel>
