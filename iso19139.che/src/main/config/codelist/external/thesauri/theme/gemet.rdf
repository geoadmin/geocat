      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15266"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/274">
      <skos:prefLabel xml:lang="en">air quality management</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Regulate and plan and work toward the accomplishment of completion of stated goals, objectives and mission pertaining to air quality.</skos:scopeNote>
