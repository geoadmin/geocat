   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4931">
      <skos:prefLabel xml:lang="en">low-level technology</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any relatively unsophisticated technical equipment or method with an amplitude or functionality below what is available in a similar or comparable system.</skos:scopeNote>
