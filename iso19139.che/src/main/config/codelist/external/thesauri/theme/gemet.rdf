   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8527">
      <skos:prefLabel xml:lang="en">touristic zone</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any section of a region which attracts travelers, often because of its scenery, objects of interest or recreational activities.</skos:scopeNote>
