   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13213">
      <skos:prefLabel xml:lang="en">energy industry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Industry which converts various types of fuels as well as solar, water, tidal, and geothermal energy into other energy forms for a variety of household, commercial, transportation, and industrial application.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">industrie énergétique</skos:prefLabel>
