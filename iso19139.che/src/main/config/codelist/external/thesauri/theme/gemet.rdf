      <skos:prefLabel xml:lang="it">scienze sociali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">sociale wetenschappen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Sozialwissenschaften</skos:prefLabel>
