   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/183">
      <skos:prefLabel xml:lang="en">agreement (contract)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An agreement, convention, or promise of two or more parties, by deed in writing, signed, and delivered, by which either of the parties pledges himself to the other that something is either done, or shall be done, or shall not be done, or stipulates for the truth of certain facts.</skos:scopeNote>
