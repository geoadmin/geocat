   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1170">
      <skos:prefLabel xml:lang="en">carbon dioxide tax</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Compulsory charges levied on fuels to reduce the output of carbon dioxide (CO2), which is a colourless and odourless gas substance that is incombustible.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">taxe sur le dioxyde de carbone</skos:prefLabel>
      <skos:prefLabel xml:lang="it">tassa sulla CO2</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">koolzuurheffing</skos:prefLabel>
      <skos:prefLabel xml:lang="de">CO2-Abgabe</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/3"/>
