   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14964">
      <skos:prefLabel xml:lang="en">forwarding agent</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A person or business that specializes in the shipment and receiving of goods.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">transporteur</skos:prefLabel>
      <skos:prefLabel xml:lang="it">spedizioniere</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">expediteur</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Spediteur</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/33"/>
