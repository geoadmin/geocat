      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6373"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6373">
      <skos:prefLabel xml:lang="en">policy instrument</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The method or mechanism used by government, political parties, business or individuals to achieve a desired effect, through legal or economic means.</skos:scopeNote>
