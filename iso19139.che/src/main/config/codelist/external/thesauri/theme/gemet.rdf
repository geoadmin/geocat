   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8946">
      <skos:prefLabel xml:lang="en">vertebrate</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any chordate animal of the subphylum Vertebrata, characterized by a bony or cartilaginous skeleton and a well-developed brain: the group contains fishes, amphibians, reptiles, birds, and mammals.</skos:scopeNote>
