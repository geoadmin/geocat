      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15263"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4167">
      <skos:prefLabel xml:lang="en">import</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The act of bringing goods and merchandise into a country from a foreign country.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">importation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">importazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">invoer</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Einfuhr</skos:prefLabel>
