      <skos:prefLabel xml:lang="en">convention</skos:prefLabel>
      <skos:scopeNote xml:lang="en">International agreement on a specific topic.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">convention</skos:prefLabel>
