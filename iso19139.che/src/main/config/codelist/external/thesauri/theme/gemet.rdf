      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7600"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7697">
      <skos:prefLabel xml:lang="en">silo</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A large round tower on a farm for storing grain or winter food for cattle.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">silo</skos:prefLabel>
      <skos:prefLabel xml:lang="it">silo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">silo</skos:prefLabel>
