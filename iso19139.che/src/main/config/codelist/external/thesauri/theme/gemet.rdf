   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/915">
      <skos:prefLabel xml:lang="en">bird species</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any species of the warm-blooded vertebrates which make up the class Aves.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">espèce d'avifaune</skos:prefLabel>
      <skos:prefLabel xml:lang="it">specie ornitiche</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vogelsoorten</skos:prefLabel>
