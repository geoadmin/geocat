   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10263">
      <skos:prefLabel xml:lang="en">municipal environment plan</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A formulated or systematic method for the management of a city or town's natural or ecological resources.</skos:scopeNote>
