   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11057">
      <skos:prefLabel xml:lang="en">audit</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The periodic or continuous verification of the accounts, assets and liabilities of a company or other organization, often to confirm compliance with legal and professional standards.</skos:scopeNote>
