      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7793"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6787">
      <skos:prefLabel xml:lang="en">public bath</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A place having baths for public use.</skos:scopeNote>
