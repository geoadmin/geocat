   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3604">
      <skos:prefLabel xml:lang="en">gaswork</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Place where gas, especially coal gas, is made.</skos:scopeNote>
