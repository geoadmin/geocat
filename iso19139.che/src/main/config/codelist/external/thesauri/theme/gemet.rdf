   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5360">
      <skos:prefLabel xml:lang="en">monument</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An object, especially large and made of stone, built to remember and show respect to a person or group of people, or a special place made for this purpose.</skos:scopeNote>
