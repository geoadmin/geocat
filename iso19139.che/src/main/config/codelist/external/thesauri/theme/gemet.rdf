   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5550">
      <skos:prefLabel xml:lang="en">navigational hazard</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any obstacle encountered by a vessel in route posing risk or danger to the vessel, its contents or the environment.</skos:scopeNote>
