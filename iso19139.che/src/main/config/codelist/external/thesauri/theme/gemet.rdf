   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13207">
      <skos:prefLabel xml:lang="en">cultivation system</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any overall structure or set-up used to organize the activity of preparing land or soil for the growth of new crops, or the activity of promoting or improving the growth of existing crops.</skos:scopeNote>
