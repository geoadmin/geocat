      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13284"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3886">
      <skos:prefLabel xml:lang="en">hearing protection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The total of measures and devices implemented to preserve persons from harm to the faculty of perceiving sound.</skos:scopeNote>
