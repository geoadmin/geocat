      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2914"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4163">
      <skos:prefLabel xml:lang="en">impact source</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Elements of an action which cause damage to the surrounding environment.</skos:scopeNote>
