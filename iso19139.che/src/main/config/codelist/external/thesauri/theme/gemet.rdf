      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6519"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1054">
      <skos:prefLabel xml:lang="en">building site preparation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">viabilisation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">preparazione di un terreno a scopo edilizio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">het bouwrijp maken van een terrein</skos:prefLabel>
