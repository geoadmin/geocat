   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11100">
      <skos:prefLabel xml:lang="en">free trade</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Trade which is unimpeded by tariffs, import and export quotas and other measures which obstruct the free movement of goods and services between states.</skos:scopeNote>
