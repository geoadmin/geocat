   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10053">
      <skos:prefLabel xml:lang="en">risk management</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process of evaluating and selecting alternative regulatory and non-regulatory responses to prepare for the probability of an accidental occurrence and its expected magnitude of damage, including the consideration of legal, economic and behavioral factors.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">gestion du risque</skos:prefLabel>
      <skos:prefLabel xml:lang="it">gestione del rischio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">risicobeheer</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Risikomanagement</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/32"/>
