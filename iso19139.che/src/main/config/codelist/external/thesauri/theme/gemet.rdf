      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/15322"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2775">
      <skos:prefLabel xml:lang="en">environmental assessment criterion</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Principle or standard for the evaluation or appraisal of ecological or natural resources.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">critère d'évaluation environnementale</skos:prefLabel>
      <skos:prefLabel xml:lang="it">criterio di valutazione ambientale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">milieuevaluatiecriterium</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Umweltbewertungskriterium</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
