      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8073"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11271">
      <skos:prefLabel xml:lang="en">road construction material</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The aggregation of components used for building streets, highways and other routes, such as asphalt, concrete, brick, sand and gravel.</skos:scopeNote>
