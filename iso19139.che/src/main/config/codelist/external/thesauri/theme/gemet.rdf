      <skos:prefLabel xml:lang="it">sistema salariale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">loonstelsel</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lohnform</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/9"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/34"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3149"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9023">
      <skos:prefLabel xml:lang="en">wall</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A vertical construction made of stone, brick, wood, etc., with a length and height much greater than its thickness, used to enclose, divide or support.</skos:scopeNote>
