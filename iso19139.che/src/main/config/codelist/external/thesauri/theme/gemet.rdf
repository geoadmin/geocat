   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/718">
      <skos:prefLabel xml:lang="en">sewage spreading prohibition</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Prohibition of spreading sewage sludge on land to prevent accumulation of toxic heavy metals in excessive quantities.</skos:scopeNote>
