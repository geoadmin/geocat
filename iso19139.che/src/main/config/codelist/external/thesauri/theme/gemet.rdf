      <skos:prefLabel xml:lang="it">eliminazione di carogne</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">karkasverwerking</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Tierkörperbeseitigung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/18"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/39"/>
