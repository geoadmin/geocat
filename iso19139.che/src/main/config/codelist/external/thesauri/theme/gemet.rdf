      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/13192"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3123"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3133">
      <skos:prefLabel xml:lang="en">fast traffic</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">trafic à grande vitesse</skos:prefLabel>
      <skos:prefLabel xml:lang="it">traffico veloce</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">snelverkeer</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schnellverkehr</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/37"/>
