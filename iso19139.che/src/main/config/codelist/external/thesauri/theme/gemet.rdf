   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/202">
      <skos:prefLabel xml:lang="en">agricultural land</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Land used primarily for the production of plant or animal crops, including arable agriculture, dairying, pasturage, apiaries, horticulture, floriculture, viticulture, animal husbandry and the necessary lands and structures needed for packing, processing, treating, or storing the produce.</skos:scopeNote>
