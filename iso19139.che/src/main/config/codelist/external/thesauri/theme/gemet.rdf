      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/277"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2923"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3300"/>
