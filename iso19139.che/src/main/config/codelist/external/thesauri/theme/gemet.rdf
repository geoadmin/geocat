   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3138">
      <skos:prefLabel xml:lang="en">fauna</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The entire animal life of a given region, habitat or geological stratum.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">faune</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fauna</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">fauna</skos:prefLabel>
