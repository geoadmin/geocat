      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4666"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1134">
      <skos:prefLabel xml:lang="en">canid</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Carnivorous mammal in the superfamily Canoidea, including dogs and their allies.</skos:scopeNote>
