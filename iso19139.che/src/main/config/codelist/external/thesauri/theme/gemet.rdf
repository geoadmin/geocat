   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11069">
      <skos:prefLabel xml:lang="en">patrimonial management</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A type of leadership and management style attempting to gain the loyalty and support of subordinates by excessively providing for their needs and interests.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">gestion patrimoniale</skos:prefLabel>
      <skos:prefLabel xml:lang="it">gestione patrimoniale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">patrimoniaal beheer</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Erbherrliches Management</skos:prefLabel>
