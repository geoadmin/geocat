      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4276"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/423">
      <skos:prefLabel xml:lang="en">animal foodstuff</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any crops or other food substances for animal consumption.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">aliment pour animaux</skos:prefLabel>
      <skos:prefLabel xml:lang="it">alimento per animali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">dierenvoeder</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Tierfutter</skos:prefLabel>
