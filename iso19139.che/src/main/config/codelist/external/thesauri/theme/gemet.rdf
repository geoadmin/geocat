   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1791">
      <skos:prefLabel xml:lang="en">co-ordination</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">coordination</skos:prefLabel>
