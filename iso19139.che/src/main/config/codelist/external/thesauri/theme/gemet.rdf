      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13260"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/939">
      <skos:prefLabel xml:lang="en">blue-green alga</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Microorganisms, formerly classified as algae but now regarded as bacteria, including nostoc, which contain a blue pigment in addition to chlorophyll.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">algue bleue</skos:prefLabel>
      <skos:prefLabel xml:lang="it">alghe verdi-azzurre</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">blauwwieren</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Blaualgen</skos:prefLabel>
