      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6033"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7933"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1190">
      <skos:prefLabel xml:lang="en">Caribbean Area</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A geographical region bordered on the south by South America and Panama, and on the west by Central America, and consisting of the West Indian, and nearby, islands and the Caribbean Sea, a part of the western Atlantic Ocean.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">Caraïbes (les)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Area Caraibica</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Caraïbische Zee</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Karibik</skos:prefLabel>
