   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2679">
      <skos:prefLabel xml:lang="en">emission to water</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The discharge of solid, liquid or gaseous pollutants or contaminants into a body of water.</skos:scopeNote>
