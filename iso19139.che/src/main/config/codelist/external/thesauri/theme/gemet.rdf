   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13309">
      <skos:prefLabel xml:lang="en">schoolwork</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The material studied in or for an educational institution, comprising homework and work done in the classroom.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">travail scolaire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">compito scolastico</skos:prefLabel>
