      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/15335"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/55">
      <skos:prefLabel xml:lang="en">acoustic insulation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process of preventing the transmission of sound by surrounding with a nonconducting material.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">isolation acoustique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">isolamento acustico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">geluidsisolatie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schallisolierung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/19"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/24"/>
