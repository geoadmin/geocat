   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8627">
      <skos:prefLabel xml:lang="en">transitional settlement</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A small village, community or group of houses, or other shelters, usually located in a thinly populated area and existing there for only a short time.</skos:scopeNote>
