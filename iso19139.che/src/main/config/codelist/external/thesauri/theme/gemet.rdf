      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9106"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/15345"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9042">
      <skos:prefLabel xml:lang="en">waste air</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Exhaust or gaseous air given off by any industrial, manufacturing or chemical process.</skos:scopeNote>
