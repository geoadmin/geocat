      <skos:prefLabel xml:lang="it">impianto per il trattamento dell'acqua</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">waterleidingbedrijf</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wasserwerk</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/5"/>
