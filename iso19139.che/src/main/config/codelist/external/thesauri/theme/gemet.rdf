   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3885">
      <skos:prefLabel xml:lang="en">hearing procedure</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any prescribed course or mode of action governing the preliminary examination by a magistrate of basic evidence and charges to determine whether criminal proceedings, a trial or other judicial actions are justified.</skos:scopeNote>
