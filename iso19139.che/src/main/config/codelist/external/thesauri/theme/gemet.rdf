   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2746">
      <skos:prefLabel xml:lang="en">energy supply</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The provision and storage of energy (the capacity to do work or produce a change), or the amount of energy stored, for the use of a municipality, or other energy user.</skos:scopeNote>
