   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4589">
      <skos:prefLabel xml:lang="en">lagoon</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A body of water cut off from the open sea by coral reefs or sand bars.</skos:scopeNote>
