      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1114"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11152">
      <skos:prefLabel xml:lang="en">agronomy</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The principles and procedures of soil management and of field crop and special-purpose plant improvement, management, and production.</skos:scopeNote>
