      <skos:prefLabel xml:lang="it">danno all'udito</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">gehoorschade</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gehörschädigung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/17"/>
