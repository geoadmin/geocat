      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3852"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5554">
      <skos:prefLabel xml:lang="en">necrosis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The pathologic death of living tissue in a plant or animal.</skos:scopeNote>
