   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7709">
      <skos:prefLabel xml:lang="en">site selection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process of choosing or picking a location or area for some designated purpose.</skos:scopeNote>
