   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15248">
      <skos:prefLabel xml:lang="en">organic fertiliser</skos:prefLabel>
      <skos:scopeNote xml:lang="en">fertiliser which consists of organic materials of biological origin</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/2"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/27"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/35"/>
