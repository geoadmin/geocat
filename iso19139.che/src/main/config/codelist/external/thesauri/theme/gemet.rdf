   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9382">
      <skos:prefLabel xml:lang="en">world heritage site</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Sites of great cultural significance and geographic areas of outstanding universal value. They include the Pyramids of Egypt, the Grand Canyon of United States, the Taj Mahal of India, the Great Wall of China, etc.</skos:scopeNote>
