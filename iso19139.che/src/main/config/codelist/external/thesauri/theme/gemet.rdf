   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10884">
      <skos:prefLabel xml:lang="en">touristic route</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An established or selected course for travel consisting, typically, of secondary roads with significant scenic, cultural, historic, geological or natural features and including vistas, rest areas, and interpretive sites matching the scenic characteristics of the course.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">circuit touristique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">itinerario turistico</skos:prefLabel>
