      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/878"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12583">
      <skos:prefLabel xml:lang="en">dechlorination</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Removal of chlorine from a substance.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchloruration</skos:prefLabel>
      <skos:prefLabel xml:lang="it">declorurazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">ontchloring</skos:prefLabel>
