      <skos:prefLabel xml:lang="it">artropodi</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">geleedpotigen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Arthropoden</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
