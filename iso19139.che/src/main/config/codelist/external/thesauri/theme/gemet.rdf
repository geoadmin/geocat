   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15179">
      <skos:prefLabel xml:lang="en">freshwater quality</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Set of parameters considered to characterize the chemical, physical, and biological properties of freshwater</skos:scopeNote>
