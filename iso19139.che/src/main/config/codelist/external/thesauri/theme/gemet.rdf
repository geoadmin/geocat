      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5196"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/335">
      <skos:prefLabel xml:lang="en">allocation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The assignment or allotment of resources to various uses in accord with a stated goal or policy.</skos:scopeNote>
