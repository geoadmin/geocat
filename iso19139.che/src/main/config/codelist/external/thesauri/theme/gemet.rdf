   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10087">
      <skos:prefLabel xml:lang="en">chemical measurement of pollution</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The quantitative determination of the presence, extent or type of pollutant substances in the environment by studying the actions or reactions of known chemicals to those pollutants.</skos:scopeNote>
