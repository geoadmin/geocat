   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5148">
      <skos:prefLabel xml:lang="en">melting</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A change of the state of a substance from the solid phase to the liquid phase. Also known as fusion.</skos:scopeNote>
