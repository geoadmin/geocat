   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2755">
      <skos:prefLabel xml:lang="en">enlargement policy</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">politique d'élargissement</skos:prefLabel>
      <skos:prefLabel xml:lang="it">politica di espansione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">uitbreidingsbeleid</skos:prefLabel>
