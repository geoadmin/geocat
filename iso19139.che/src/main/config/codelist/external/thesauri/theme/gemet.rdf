   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12430">
      <skos:prefLabel xml:lang="en">treatment residue</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Material left over from the treatment of any type of waste.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">résidu d'épuration</skos:prefLabel>
      <skos:prefLabel xml:lang="it">residuo di trattamento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">zuiveringsrest</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Reinigungsrückstände</skos:prefLabel>
