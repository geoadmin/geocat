      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/11277"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/22"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3963"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5395"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7293"/>
