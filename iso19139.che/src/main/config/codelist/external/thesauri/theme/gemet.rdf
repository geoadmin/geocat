   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1115">
      <skos:prefLabel xml:lang="en">calibration of measuring equipment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The determination or rectification of, according to an accepted standard, the graduation of any instrument giving quantitative measurements.</skos:scopeNote>
