   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13215">
      <skos:prefLabel xml:lang="en">information technology industry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A sector of the economy in which an aggregate of commercial enterprises is engaged in the design, manufacture and marketing of electronic machines designed to accept information or data that is easily manipulated for some result based on a program or some set of instructions, and the technology or materials used with these machines, such as storage devices, terminals and peripheral equipment.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">industrie informatique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">industria dell'informatica</skos:prefLabel>
