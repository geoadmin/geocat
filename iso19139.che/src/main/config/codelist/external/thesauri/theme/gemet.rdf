   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8415">
      <skos:prefLabel xml:lang="en">test organism</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any animal organism used for scientific research.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">organisme de test</skos:prefLabel>
      <skos:prefLabel xml:lang="it">organismo da esperimento</skos:prefLabel>
