   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1177">
      <skos:prefLabel xml:lang="en">carcass disposal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The disposal of slaughtered animals, other dead animal bodies and animal body parts after removal of the offal products.</skos:scopeNote>
