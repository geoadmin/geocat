      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/77">
      <skos:prefLabel xml:lang="en">active participation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The involvement, either by an individual or a group of individuals, in their own governance or other activities, with the purpose of exerting influence.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">participation active</skos:prefLabel>
      <skos:prefLabel xml:lang="it">voce in capitolo</skos:prefLabel>
