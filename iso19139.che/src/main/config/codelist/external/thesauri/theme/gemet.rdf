   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1350">
      <skos:prefLabel xml:lang="en">child</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A person below the age of puberty.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">enfant</skos:prefLabel>
      <skos:prefLabel xml:lang="it">bambino</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">kind</skos:prefLabel>
