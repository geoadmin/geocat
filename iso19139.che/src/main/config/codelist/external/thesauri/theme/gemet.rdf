   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/387">
      <skos:prefLabel xml:lang="en">amphibian</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A class of vertebrate animals characterized by a moist, glandular skin, gills at some stage of development, and no amnion during the embryonic stage.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">batracien</skos:prefLabel>
      <skos:prefLabel xml:lang="it">anfibi</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">amfibieën</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Amphibien</skos:prefLabel>
