      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4254"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6263">
      <skos:prefLabel xml:lang="en">pilot project</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A small scale experiment or set of observations undertaken to decide how and whether to launch a full-scale project.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">projet pilote</skos:prefLabel>
      <skos:prefLabel xml:lang="it">progetto pilota</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">proefproject</skos:prefLabel>
