   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3947">
      <skos:prefLabel xml:lang="en">highland ecosystem</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The interacting systems of the biological communities and their non-living surroundings in regions of relatively high elevation, typically characterized by decreased air pressure and temperature, reduced oxygen availability and increased isolation.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">écosystème de  montagne</skos:prefLabel>
