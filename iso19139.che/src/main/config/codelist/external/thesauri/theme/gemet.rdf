      <skos:prefLabel xml:lang="it">metalli tossici</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">giftig metaal</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Toxische Metalle</skos:prefLabel>
