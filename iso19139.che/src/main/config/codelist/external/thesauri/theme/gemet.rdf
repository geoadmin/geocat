   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2657">
      <skos:prefLabel xml:lang="en">emergency relief</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Money, food or other assistance provided for those surviving a sudden and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment.</skos:scopeNote>
