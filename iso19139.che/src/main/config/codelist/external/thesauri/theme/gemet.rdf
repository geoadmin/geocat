      <skos:prefLabel xml:lang="it">miniera esaurita</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">volledig ontgonnen open mijn</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Restloch</skos:prefLabel>
