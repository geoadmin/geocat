   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9235">
      <skos:prefLabel xml:lang="en">watershed</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The dividing line between two adjacent river systems, such as a ridge.</skos:scopeNote>
