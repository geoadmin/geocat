      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/731"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4802">
      <skos:prefLabel xml:lang="en">life cycle</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The phases, changes, or stages through which an organism passes throughout its lifetime.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">cycle de la vie</skos:prefLabel>
      <skos:prefLabel xml:lang="it">ciclo vitale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">levenscyclus</skos:prefLabel>
