      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8478"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7404">
      <skos:prefLabel xml:lang="en">salvage</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The act, process, or business of rescuing vessels or their cargoes from loss at sea.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">valorisation de terres</skos:prefLabel>
      <skos:prefLabel xml:lang="it">ricupero in mare</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">berging</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bergung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/17"/>
