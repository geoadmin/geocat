   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4362">
      <skos:prefLabel xml:lang="en">inspection service</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An organization designated to look into, supervise and report upon, the staff members and workings of some institution or department, or the conforming to laws and regulations by a segment of society or other group.</skos:scopeNote>
