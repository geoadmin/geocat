   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2579">
      <skos:prefLabel xml:lang="en">EIA law</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Law concerning the assessment of the effects of certain public and private projects on the environment, based on the EC Directive n. 85/337.</skos:scopeNote>
