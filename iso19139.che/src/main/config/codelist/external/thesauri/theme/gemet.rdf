      <skos:prefLabel xml:lang="it">zona di prelazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">zone die valt onder een recht van voorkoop</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gebiet mit Vorkaufsrecht</skos:prefLabel>
