   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7712">
      <skos:prefLabel xml:lang="en">sizing</skos:prefLabel>
      <skos:scopeNote xml:lang="en">To fix the cross-section of structural components on the basis of statics and material strength.</skos:scopeNote>
