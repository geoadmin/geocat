      <skos:prefLabel xml:lang="fr">plan d'amélioration du voisinage</skos:prefLabel>
      <skos:prefLabel xml:lang="it">programma di miglioramento di quartiere</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">buurtverbeteringsplan</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Stadtteilentwicklungsprogramm</skos:prefLabel>
