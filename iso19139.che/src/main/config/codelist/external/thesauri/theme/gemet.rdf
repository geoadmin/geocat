   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/816">
      <skos:prefLabel xml:lang="en">biocide</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A diverse group of poisonous substance including preservatives, insecticides, disinfectants and pesticides used for the control of organisms that are harmful to human or animal health or that cause damage to natural or manufactured products.</skos:scopeNote>
