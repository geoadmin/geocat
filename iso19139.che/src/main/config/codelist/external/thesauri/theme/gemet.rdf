   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5789">
      <skos:prefLabel xml:lang="en">ocean</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The mass of water occupying all of the Earth's surface not occupied by land, but excluding all lakes and inland seas.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">océan</skos:prefLabel>
      <skos:prefLabel xml:lang="it">oceano</skos:prefLabel>
