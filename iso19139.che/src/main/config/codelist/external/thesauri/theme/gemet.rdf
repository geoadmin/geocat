   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4597">
      <skos:prefLabel xml:lang="en">lamp</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A device that produces light, such as an electric lamp.</skos:scopeNote>
