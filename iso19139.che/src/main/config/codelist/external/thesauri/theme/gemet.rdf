      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/34"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4581"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13342">
      <skos:prefLabel xml:lang="en">leave on social grounds</skos:prefLabel>
