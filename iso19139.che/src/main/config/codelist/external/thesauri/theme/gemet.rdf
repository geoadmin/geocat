      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8262"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10496">
      <skos:prefLabel xml:lang="en">nesting area</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A place where birds gather to lay eggs.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">aire de nidification</skos:prefLabel>
      <skos:prefLabel xml:lang="it">area di nidificazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">nestgebied</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nistgebiet</skos:prefLabel>
