   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9130">
      <skos:prefLabel xml:lang="en">waste water disposal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Collection and removal of wastewater deriving from industrial and urban settlements by means of a system of pipes and treatment plants.</skos:scopeNote>
