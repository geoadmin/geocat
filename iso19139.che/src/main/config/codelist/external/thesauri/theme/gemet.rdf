   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/59">
      <skos:prefLabel xml:lang="en">acoustic property</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The characteristics found within a structure that determine the quality of sound in its relevance to hearing.</skos:scopeNote>
