      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7632"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12444">
      <skos:prefLabel xml:lang="en">thickening</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any process beyond gravity sedimentation that increases the concentration of solids in sludge with or without the use of chemical flocculants.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">épaississement</skos:prefLabel>
      <skos:prefLabel xml:lang="it">ispessimento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">verdikking</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Verdickung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/39"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
