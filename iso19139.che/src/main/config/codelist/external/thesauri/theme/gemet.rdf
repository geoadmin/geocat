      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4046"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5555">
      <skos:prefLabel xml:lang="en">need</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The fact or an instance of feeling the lack of something.</skos:scopeNote>
