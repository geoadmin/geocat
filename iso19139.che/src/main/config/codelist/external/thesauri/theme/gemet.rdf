   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/130">
      <skos:prefLabel xml:lang="en">advice</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An official notice, opinion, counsel or recommendation that is optional or at the receiver's discretion.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">conseil</skos:prefLabel>
      <skos:prefLabel xml:lang="it">consulenza</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">raad</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gutachten</skos:prefLabel>
