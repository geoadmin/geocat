      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/111"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11490">
      <skos:prefLabel xml:lang="en">circular mail</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A memorandum, letter or notice in either paper or electronic format distributed widely throughout an organization or to a general list of interested parties.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">circulaire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lettera circolare</skos:prefLabel>
