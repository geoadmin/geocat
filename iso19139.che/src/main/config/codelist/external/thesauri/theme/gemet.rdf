   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6519">
      <skos:prefLabel xml:lang="en">population (ecological)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A group of organisms of one species, occupying a defined area.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">population (écologique)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">popolazione (ecologia)</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">populatie (ecologisch)</skos:prefLabel>
