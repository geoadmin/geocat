      <skos:prefLabel xml:lang="it">area protetta</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">beschermd gebied</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schutzgebiet</skos:prefLabel>
