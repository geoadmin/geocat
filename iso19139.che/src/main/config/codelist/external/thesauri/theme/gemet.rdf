      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1743"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9041">
      <skos:prefLabel xml:lang="en">waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Material, often unusable, left over from any manufacturing, industrial, agricultural or other human process; Material damaged or altered during a manufacturing process and subsequently left useless.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchets</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuti</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">soorten afval</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Abfall</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/39"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5437"/>
