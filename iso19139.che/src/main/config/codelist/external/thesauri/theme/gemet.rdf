   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2889">
      <skos:prefLabel xml:lang="en">environmental planning</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The identification of desirable objectives for the physical environment, including social and economic objectives, and the creation of administrative procedures and programmes to meet those objectives.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">planification écologique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">pianificazione ambientale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">milieuplanning</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Umweltplanung</skos:prefLabel>
