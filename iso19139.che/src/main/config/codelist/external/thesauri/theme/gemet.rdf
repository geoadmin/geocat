   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4371">
      <skos:prefLabel xml:lang="en">sound insulation material</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Material used to reduce the transmission of sound to or from a body, device, room, etc.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">matériau isolant</skos:prefLabel>
      <skos:prefLabel xml:lang="it">materiale insonorizzante</skos:prefLabel>
