   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7452">
      <skos:prefLabel xml:lang="en">satellite</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An object that orbits around a larger one. Artificial satellites orbiting the Earth are used for communications, the gathering of military intelligence, the monitoring of weather and other environmental phenomena, etc.</skos:scopeNote>
