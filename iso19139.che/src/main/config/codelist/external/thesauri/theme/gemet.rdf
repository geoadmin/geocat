   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2330">
      <skos:prefLabel xml:lang="en">olive oil mill waste water</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Aqueous residue deriving from the process of oil extraction from olives; it is composed of the olive-combined water and of the water used in the extraction and washing processes. It also contains a certain percentage of mineral compounds and of organic substances that are only partially biodegradable.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">lies d'huile</skos:prefLabel>
      <skos:prefLabel xml:lang="it">effluenti di frantoio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">oliebezinksel</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ölrückstände</skos:prefLabel>
