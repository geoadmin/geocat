   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/861">
      <skos:prefLabel xml:lang="en">biological monitoring</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The direct measurement of changes in the biological status of a habitat, based on evaluations of the number and distribution of individuals or species before and after a change.</skos:scopeNote>
