      <skos:prefLabel xml:lang="it">livello del rumore</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">geluidsniveau</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lärmpegel</skos:prefLabel>
