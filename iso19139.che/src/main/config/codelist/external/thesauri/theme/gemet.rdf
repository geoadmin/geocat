   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11816">
      <skos:prefLabel xml:lang="en">organoleptic property</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Properties that can be perceived by sense organs.</skos:scopeNote>
