   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5199">
      <skos:prefLabel xml:lang="en">methane</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A colourless, odourless, and tasteless gas, lighter than air and reacting violently with chlorine and bromine in sunlight, a chief component of natural gas; used as a source of methanol, acetylene, and carbon monoxide. Also known as methyl hydride.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">méthane</skos:prefLabel>
      <skos:prefLabel xml:lang="it">metano</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">moerasgas</skos:prefLabel>
