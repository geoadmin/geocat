      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3866"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14835">
      <skos:prefLabel xml:lang="en">green fiscal instrument</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">instruments de fiscalité "verte"</skos:prefLabel>
