      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4906"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6459"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6889"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/7688"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/849"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8801"/>
