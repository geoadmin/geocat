   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4414">
      <skos:prefLabel xml:lang="en">internal European market</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">marché intérieur européen</skos:prefLabel>
