   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9366">
      <skos:prefLabel xml:lang="en">work accident</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Accident occurring in the course of the employment and caused by inherent or related factors arising from the operation of materials of one's occupation.</skos:scopeNote>
