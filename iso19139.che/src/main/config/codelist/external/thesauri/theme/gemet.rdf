      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/303"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7030">
      <skos:prefLabel xml:lang="en">chemical reduction</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Chemical reaction in which an element gains an electron.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">réduction (chimie)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">riduzione chimica</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">chemische reductie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Reduktion (chemisch)</skos:prefLabel>
