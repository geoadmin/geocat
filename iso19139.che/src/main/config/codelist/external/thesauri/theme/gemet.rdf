      <skos:scopeNote xml:lang="en">Potential supplies of energy which have not yet been used (such as coal lying in the ground, solar heat, wind power, geothermal power, etc.).</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">ressource énergétique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">risorse energetiche</skos:prefLabel>
