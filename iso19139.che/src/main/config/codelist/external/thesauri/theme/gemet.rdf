      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5265"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5274"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5510"/>
