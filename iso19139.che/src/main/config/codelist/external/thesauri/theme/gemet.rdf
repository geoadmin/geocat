   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7715">
      <skos:prefLabel xml:lang="en">skiing</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Gliding over snow on skis, especially as a sport.</skos:scopeNote>
