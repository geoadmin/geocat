   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4037">
      <skos:prefLabel xml:lang="en">housing programme</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A planned system of projects, services or activities intended to support individuals or families in need of shelter, including transitional or permanent housing and safe havens for low-income, elderly or homeless populations.</skos:scopeNote>
