   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1889">
      <skos:prefLabel xml:lang="en">crustacean</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A class of arthropod animals having jointed feet and mandibles, two pairs of antennae, and segmented, chitin-encased bodies.</skos:scopeNote>
