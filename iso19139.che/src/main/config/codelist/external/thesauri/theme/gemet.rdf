      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15243"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2290">
      <skos:prefLabel xml:lang="en">domestic appliance</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A machine or device, especially an electrical one used domestically.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">appareil électro-ménager</skos:prefLabel>
