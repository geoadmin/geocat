      <skos:prefLabel xml:lang="it">insediamenti rurali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">nederzetting in het platteland</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ländliche Siedlung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/2"/>
