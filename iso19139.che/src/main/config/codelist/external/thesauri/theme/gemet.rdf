      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8629"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8894">
      <skos:prefLabel xml:lang="en">vandalism</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The deliberate or wanton destruction of personal or public property caused by a vandal.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">vandalisme</skos:prefLabel>
      <skos:prefLabel xml:lang="it">vandalismo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vandalisme</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Vandalismus</skos:prefLabel>
