      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9051"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12383">
      <skos:prefLabel xml:lang="en">mineral waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Waste material resulting from ore extraction that is usually left on the soil surface.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchet minéral</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuto minerale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">anorganisch afval</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Mineralstoffabfall</skos:prefLabel>
