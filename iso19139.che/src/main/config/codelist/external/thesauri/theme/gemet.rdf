      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5135"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6183">
      <skos:prefLabel xml:lang="en">phenol</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A white crystalline soluble poisonous acidic derivative of benzene, used as an antiseptic and disinfectant and in the manufacture of resins, nylon, dyes, explosives and pharmaceuticals.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">phénol</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fenoli</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">fenol</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Phenol</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/6"/>
