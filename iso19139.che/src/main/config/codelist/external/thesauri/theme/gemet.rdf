      <skos:prefLabel xml:lang="it">conservazione delle risorse idriche</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">waterbronnenbescherming</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schutz der Wasserressourcen</skos:prefLabel>
