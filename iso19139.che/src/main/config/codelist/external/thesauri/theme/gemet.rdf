   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6523">
      <skos:prefLabel xml:lang="en">population growth</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An increase in the total number of inhabitants of a country, city, district or area.</skos:scopeNote>
