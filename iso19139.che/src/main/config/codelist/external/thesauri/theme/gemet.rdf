      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/15"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1324"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7032">
      <skos:prefLabel xml:lang="en">reed</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any of various types of tall stiff grass-like plants growing together in groups near water.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">roseau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">canne</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">riet</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schilf</skos:prefLabel>
