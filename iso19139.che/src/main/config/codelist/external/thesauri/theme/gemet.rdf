      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4257"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9229">
      <skos:prefLabel xml:lang="en">water salination</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Process by which water becomes more salty, found especially in hot countries where irrigation is practised.</skos:scopeNote>
