   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9147">
      <skos:prefLabel xml:lang="en">water analysis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Study of the chemical, physical and biological properties of water.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">analyse de l'eau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">analisi dell'acqua</skos:prefLabel>
