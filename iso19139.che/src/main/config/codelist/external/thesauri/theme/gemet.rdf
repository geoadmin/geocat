   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2291">
      <skos:prefLabel xml:lang="en">domesticated animal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">1) Wild animal which has been trained to live near a house and not be frightened of human beings; 2) species which was formerly wild, now selectively bred to fill human needs.</skos:scopeNote>
