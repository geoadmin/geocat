   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3028">
      <skos:prefLabel xml:lang="en">excavated hole</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A pit, cavity, or other uncovered cutting produced by excavation.</skos:scopeNote>
