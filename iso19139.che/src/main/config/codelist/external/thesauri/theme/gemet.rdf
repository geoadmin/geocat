      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15325"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4184">
      <skos:prefLabel xml:lang="en">incinerator</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Device which burns waste.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">incinérateur</skos:prefLabel>
      <skos:prefLabel xml:lang="it">inceneritore</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">verbrandingsinstallatie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Verbrennungsanlage</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/5"/>
