      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2470"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/3633"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5524"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8313"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/881"/>
