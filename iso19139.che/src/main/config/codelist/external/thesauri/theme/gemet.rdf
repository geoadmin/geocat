   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7168">
      <skos:prefLabel xml:lang="en">resource</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any component of the environment that can be utilized by an organism.</skos:scopeNote>
