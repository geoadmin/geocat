      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/2179"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/2294"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3505"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15224"/>
