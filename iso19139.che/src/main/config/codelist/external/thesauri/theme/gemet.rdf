   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5231">
      <skos:prefLabel xml:lang="en">microwave</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An electromagnetic wave which has a wavelength between about 0.3 and 30 centimeters, corresponding to frequencies of 1-100 gigahertz; however there are no sharp boundaries between microwaves and infrared and radio waves.</skos:scopeNote>
