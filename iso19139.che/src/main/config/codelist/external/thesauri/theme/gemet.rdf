      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6205"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/626">
      <skos:prefLabel xml:lang="en">atmospheric humidity</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A measurable quantity of the moisture content found in the earth's atmosphere.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">humidité de l'air</skos:prefLabel>
      <skos:prefLabel xml:lang="it">umidità atmosferica</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">atmosferische vochtigheid</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Luftfeuchtigkeit</skos:prefLabel>
