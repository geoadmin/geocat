      <skos:scopeNote xml:lang="en">Not domesticated animals living independently of man.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">faune sauvage</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fauna selvatica</skos:prefLabel>
