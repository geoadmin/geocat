   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10785">
      <skos:prefLabel xml:lang="en">pedagogy</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The principles, practice, or profession of teaching.</skos:scopeNote>
