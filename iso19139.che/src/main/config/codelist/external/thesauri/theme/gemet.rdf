      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4234"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1786">
      <skos:prefLabel xml:lang="en">cooling water</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Water used to make something less hot, such as the irradiated elements from a nuclear reactor or the engine of a machine.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">eau de refroidissement</skos:prefLabel>
      <skos:prefLabel xml:lang="it">acqua di raffreddamento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">koelwater</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Kühlwasser</skos:prefLabel>
