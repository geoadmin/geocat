   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10922">
      <skos:prefLabel xml:lang="en">active population</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The number of people available and eligible for employment within a given enterprise, region or nation.</skos:scopeNote>
