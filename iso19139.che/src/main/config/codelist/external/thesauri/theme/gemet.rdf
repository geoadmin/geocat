      <skos:prefLabel xml:lang="it">crescita della popolazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">bevolkingsgroei</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Bevölkerungswachstum</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/34"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6528"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6525">
      <skos:prefLabel xml:lang="en">population movement</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any shift or migration of a statistically significant number of persons inhabiting a country, district or area.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">mouvement de population</skos:prefLabel>
      <skos:prefLabel xml:lang="it">movimento di popolazioni</skos:prefLabel>
