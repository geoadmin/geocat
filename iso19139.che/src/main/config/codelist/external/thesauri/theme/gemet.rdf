   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3207">
      <skos:prefLabel xml:lang="en">fine</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A pecuniary punishment or penalty imposed by lawful tribunal upon person convicted of crime or misdemeanor.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">amende</skos:prefLabel>
      <skos:prefLabel xml:lang="it">multa</skos:prefLabel>
