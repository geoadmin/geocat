   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4575">
      <skos:prefLabel xml:lang="en">laboratory waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Discarded materials produced by analytical and research activities in a laboratory.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchet de laboratoire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuto di laboratorio</skos:prefLabel>
