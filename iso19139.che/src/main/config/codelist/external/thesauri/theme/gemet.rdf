   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13160">
      <skos:prefLabel xml:lang="en">business classification</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The categorization of enterprises or organizations involved in an economy.</skos:scopeNote>
