   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6750">
      <skos:prefLabel xml:lang="en">protection of birds</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">protection des oiseaux</skos:prefLabel>
      <skos:prefLabel xml:lang="it">protezione degli uccelli</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vogelbescherming</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Vogelschutz</skos:prefLabel>
