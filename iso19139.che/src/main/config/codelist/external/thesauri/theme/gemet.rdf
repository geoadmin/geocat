      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1033"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9028">
      <skos:prefLabel xml:lang="en">war</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A conflict or a state of hostility between two or more parties, nations or states, in which armed forces or military operations are used.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">guerre</skos:prefLabel>
      <skos:prefLabel xml:lang="it">guerra</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">oorlog</skos:prefLabel>
