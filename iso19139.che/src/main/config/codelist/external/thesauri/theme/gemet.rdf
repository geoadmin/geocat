   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4920">
      <skos:prefLabel xml:lang="en">Lower House</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The body of a bicameral legislature composed of representatives elected by the general populace and organized into electorates or districts, each comprising an equal number of citizens.</skos:scopeNote>
