      <skos:prefLabel xml:lang="fr">loi de mise en oeuvre</skos:prefLabel>
      <skos:prefLabel xml:lang="it">legge esecutiva</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">uitvoeringswet</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ausführungsgesetz</skos:prefLabel>
