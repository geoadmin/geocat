      <skos:prefLabel xml:lang="en">chemical pollution</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Pollution caused by substances of chemical nature, including chlorinated hydrocarbon pesticides, polychlorinated biphenyls, metals as mercury, lead, cadmium, arsenic, etc.</skos:scopeNote>
