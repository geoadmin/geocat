   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8592">
      <skos:prefLabel xml:lang="en">traffic jam</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A number of vehicles so obstructed that they can scarcely move.</skos:scopeNote>
