      <skos:prefLabel xml:lang="en">leisure activity</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Sports and recreational activities carried out in the time free from work or other duties.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">loisirs</skos:prefLabel>
      <skos:prefLabel xml:lang="it">attività ricreative</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vrijetijdsbesteding</skos:prefLabel>
