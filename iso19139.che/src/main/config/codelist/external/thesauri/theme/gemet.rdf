      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10661"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/14602"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/28"/>
