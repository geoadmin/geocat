      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3174"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8278">
      <skos:prefLabel xml:lang="en">systems analysis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A means of organizing elements into an integrated analytic and/or decisionmaking procedure to achieve the best possible results.</skos:scopeNote>
