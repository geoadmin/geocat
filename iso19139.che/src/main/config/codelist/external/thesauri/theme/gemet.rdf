   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6989">
      <skos:prefLabel xml:lang="en">recommendation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Recommendation refers to an action which is advisory in nature rather than one having any binding effect.</skos:scopeNote>
