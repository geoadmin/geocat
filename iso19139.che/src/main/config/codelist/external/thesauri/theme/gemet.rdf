      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15309"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7355">
      <skos:prefLabel xml:lang="en">rural water supply</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">approvisionnement en eau des zones rurales</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fabbisogno agricolo di acqua</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">plattelandswatervoorziening</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ländliche Wasserversorgung</skos:prefLabel>
