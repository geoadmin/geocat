   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12381">
      <skos:prefLabel xml:lang="en">special industrial waste</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Discarded material produced in any industrial process for which there is no specified mode of disposal.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">déchet industriel spécial</skos:prefLabel>
      <skos:prefLabel xml:lang="it">rifiuto industriale speciale</skos:prefLabel>
