   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11508">
      <skos:prefLabel xml:lang="en">law draft</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The form in which proposed statutes, resolutions or special acts are introduced into a legislative body, before they are enacted or passed.</skos:scopeNote>
