   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/895">
      <skos:prefLabel xml:lang="en">biosynthesis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Production, by synthesis or degradation, of a chemical compound by a living organism.</skos:scopeNote>
