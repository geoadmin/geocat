   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13308">
      <skos:prefLabel xml:lang="en">general education</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Informal learning or formal instruction with broad application to human existence beyond the domain of any particular subject or discipline, often equated with liberal arts in the university setting and contrasted to courses required for a specific major or program.</skos:scopeNote>
