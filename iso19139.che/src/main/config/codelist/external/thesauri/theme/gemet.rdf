      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5741"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5713">
      <skos:prefLabel xml:lang="en">nuclear energy legislation</skos:prefLabel>
