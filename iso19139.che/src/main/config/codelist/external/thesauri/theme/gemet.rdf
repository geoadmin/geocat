      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/232"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4505"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5009"/>
