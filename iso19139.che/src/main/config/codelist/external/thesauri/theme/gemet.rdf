      <skos:prefLabel xml:lang="it">rischio di cancro</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">risico op kanker</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Krebsrisiko</skos:prefLabel>
