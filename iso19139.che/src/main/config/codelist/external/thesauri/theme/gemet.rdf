   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6743">
      <skos:prefLabel xml:lang="en">protected landscape</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Natural or man-made areas which have been reserved for conservation, scientific, educational and/or recreational purposes.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">site naturel protégé</skos:prefLabel>
      <skos:prefLabel xml:lang="it">paesaggio protetto</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">beschermd landschap</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Geschützte Landschaft</skos:prefLabel>
