   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/90">
      <skos:prefLabel xml:lang="en">adhesive</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Substance used for sticking objects together, such as glue, cement, or paste.</skos:scopeNote>
