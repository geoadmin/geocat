      <skos:prefLabel xml:lang="it">ente per l'energia</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">energiebedrijf</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Energieversorgungsunternehmen</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/9"/>
