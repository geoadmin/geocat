      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3516"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3516">
      <skos:prefLabel xml:lang="en">fuel tank installation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The operating, fuel-storage component of a fuel system.</skos:scopeNote>
