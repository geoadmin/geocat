      <skos:prefLabel xml:lang="it">acqua di rifiuto da attività commerciali</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">industrieel afvalwater</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gewerbliches Abwasser</skos:prefLabel>
