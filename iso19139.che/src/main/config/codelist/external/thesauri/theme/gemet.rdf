      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9254"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9246">
      <skos:prefLabel xml:lang="en">water treatment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Purification of water to make it suitable for drinking or for any other use.</skos:scopeNote>
