   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4771">
      <skos:prefLabel xml:lang="en">leisure time</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Time free from work or other duties; spare time.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">temps libre</skos:prefLabel>
      <skos:prefLabel xml:lang="it">tempo libero</skos:prefLabel>
