   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3874">
      <skos:prefLabel xml:lang="en">health legislation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Laws, ordinances, or codes prescribing sanitary, clean air, etc., standards and regulations, designed to promote and preserve the health of the community and working conditions of businesses.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">législation sanitaire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">legislazione sanitaria</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">gezondheidswetgeving</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gesundheitsrecht</skos:prefLabel>
