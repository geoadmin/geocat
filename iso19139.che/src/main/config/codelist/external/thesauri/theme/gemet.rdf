   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4600">
      <skos:prefLabel xml:lang="en">land access</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The permission or freedom to use, enter, approach or pass to and from a tract of land, which often consists of real estate property.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">accès à la terre</skos:prefLabel>
      <skos:prefLabel xml:lang="it">accesso al territorio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">toegang tot land</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Landzugang</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/1"/>
