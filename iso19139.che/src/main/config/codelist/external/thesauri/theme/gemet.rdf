   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8407">
      <skos:prefLabel xml:lang="en">test animal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Animals on which experiments are conducted in order to provide evidence for or against a scientific hypothesis, or to prove the efficacy of drugs or the reaction to certain products.</skos:scopeNote>
