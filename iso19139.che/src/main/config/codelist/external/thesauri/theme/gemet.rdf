      <skos:prefLabel xml:lang="it">protezione della salute</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">gezondheidsbescherming</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gesundheitsschutz</skos:prefLabel>
