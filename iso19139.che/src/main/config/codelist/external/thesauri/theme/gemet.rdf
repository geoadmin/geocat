   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9367">
      <skos:prefLabel xml:lang="en">worked-out open cut</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A mine where all the mineral that could be profitably exploited has been removed.</skos:scopeNote>
