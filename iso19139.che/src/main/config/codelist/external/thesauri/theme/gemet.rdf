      <skos:prefLabel xml:lang="it">riduzione del rumore</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">lawaaibeperking</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lärmminderung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/19"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/24"/>
