      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2284"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8967">
      <skos:prefLabel xml:lang="en">village</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A group of houses and other buildings, such as a church, a school and some shops, which is smaller than a town, usually in the countryside.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">village</skos:prefLabel>
      <skos:prefLabel xml:lang="it">villaggio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">dorp</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Dorf</skos:prefLabel>
