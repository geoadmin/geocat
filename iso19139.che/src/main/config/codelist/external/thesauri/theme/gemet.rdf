      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15274"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15226">
      <skos:prefLabel xml:lang="en">marine fuel oil</skos:prefLabel>
      <skos:scopeNote xml:lang="en">mixture of marine-gas-oil and residual fuel oil</skos:scopeNote>
