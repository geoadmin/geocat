      <skos:prefLabel xml:lang="it">scavo (fossa)</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">afgraving</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Baggerloch</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/5"/>
