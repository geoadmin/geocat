   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11798">
      <skos:prefLabel xml:lang="en">physicochemical analysis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Analysis based on the physical changes associated with chemical reactions.</skos:scopeNote>
