   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9153">
      <skos:prefLabel xml:lang="en">water bottom</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The floor upon which any body of water rests.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">fond de l'eau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fondo di corpo idrico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">waterbodem</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Gewässersohle</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/35"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9151"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9157">
      <skos:prefLabel xml:lang="en">water collection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The catching of water, especially rain water, in a structure such as a basin or reservoir.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">captage d'eau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">captazione di acqua</skos:prefLabel>
