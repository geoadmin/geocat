   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2656">
      <skos:prefLabel xml:lang="en">emergency plan</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Program of procedures to be undertaken in the event of a sudden, urgent and usually unexpected occurrence requiring immediate action, especially an incident of potential harm to human life, property or the environment.</skos:scopeNote>
