   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7034">
      <skos:prefLabel xml:lang="en">reef</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A line of rocks in the tidal zone of a coast, submerged at high water but partly uncovered at low water.</skos:scopeNote>
