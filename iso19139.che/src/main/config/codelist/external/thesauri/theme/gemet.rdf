      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4205"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4382"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/4931"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/498"/>
