      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8141"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8844">
      <skos:prefLabel xml:lang="en">urban structure</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The built-up components, the street system and the facilities which make up an urban unit.</skos:scopeNote>
