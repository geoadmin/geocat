      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/9267"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5565">
      <skos:prefLabel xml:lang="en">nematode</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A group of unsegmented worms which have been variously recognized as an order, class, and phylum.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">nématodes</skos:prefLabel>
      <skos:prefLabel xml:lang="it">nematodi</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">aaltjes</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Nematoden</skos:prefLabel>
