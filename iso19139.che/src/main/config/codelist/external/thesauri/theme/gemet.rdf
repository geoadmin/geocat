      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/6161"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12395">
      <skos:prefLabel xml:lang="en">whey</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The watery liquid that separates from the curd when the milk is clotted, as in making cheese.</skos:scopeNote>
