   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6630">
      <skos:prefLabel xml:lang="en">printing work</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The art, process or business of producing reproductions of written text or images in multiple copies, in book, periodical or newspaper formats, or in other similar formats.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">imprimerie</skos:prefLabel>
      <skos:prefLabel xml:lang="it">tipografia</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">drukkerij</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Druckerei</skos:prefLabel>
