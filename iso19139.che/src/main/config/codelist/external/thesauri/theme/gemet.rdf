      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/27"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2389"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3362">
      <skos:prefLabel xml:lang="en">food commerce</skos:prefLabel>
