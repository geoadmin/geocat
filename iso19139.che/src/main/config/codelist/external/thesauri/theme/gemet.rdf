   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4030">
      <skos:prefLabel xml:lang="en">housing improvement</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An addition, renovation or repair to a place of residence that increases its aesthetic, functional or financial value.</skos:scopeNote>
