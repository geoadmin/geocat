   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9065">
      <skos:prefLabel xml:lang="en">waste disposal cost</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The amount of money incurred for the action of removing or getting rid of refuse or unwanted materials left over from a manufacturing process.</skos:scopeNote>
