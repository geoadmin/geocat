   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7120">
      <skos:prefLabel xml:lang="en">reproduction (biological)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any of various processes, either sexual or asexual, by which an animal or plant produces one or more individuals similar to itself.</skos:scopeNote>
