   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7720">
      <skos:prefLabel xml:lang="en">slag</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A nonmetallic product resulting from the interaction of flux and impurities in the smelting and refining of metals.</skos:scopeNote>
