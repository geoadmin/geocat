   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10605">
      <skos:prefLabel xml:lang="en">chestnut</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any north temperate fagaceous tree of the genus Castanea, such as Castanea sativa, which produce flowers in long catkins and nuts in a prickly bur.</skos:scopeNote>
