      <skos:prefLabel xml:lang="it">colorante alimentare</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">voedselkleurstof</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lebensmittelfarbe</skos:prefLabel>
