      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/832"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/52">
      <skos:prefLabel xml:lang="en">acid</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A compound capable of transferring a hydrogen ion in solution.</skos:scopeNote>
