      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9028"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13325">
      <skos:prefLabel xml:lang="en">internal migration</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A population shift occurring within national or territorial boundaries, often characterized by persons seeking labor opportunities in more advantageous areas.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">migration intérieure</skos:prefLabel>
      <skos:prefLabel xml:lang="it">migrazione interna</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">binnenlandse migratie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Binnenwanderung</skos:prefLabel>
