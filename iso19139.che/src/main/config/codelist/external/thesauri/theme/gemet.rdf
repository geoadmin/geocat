      <skos:prefLabel xml:lang="nl">klimaattype</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Klimatyp</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/7"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12060"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/12061"/>
