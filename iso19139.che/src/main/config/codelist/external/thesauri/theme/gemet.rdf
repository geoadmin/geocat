   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4296">
      <skos:prefLabel xml:lang="en">inflammable substance</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Substance liable to catch fire.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">substance inflammable</skos:prefLabel>
      <skos:prefLabel xml:lang="it">sostanza infiammabile</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">brandgevaarlijke stof</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Brennbarer Stoff</skos:prefLabel>
