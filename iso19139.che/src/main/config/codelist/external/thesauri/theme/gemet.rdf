   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8655">
      <skos:prefLabel xml:lang="en">trapping</skos:prefLabel>
      <skos:scopeNote xml:lang="en">To catch an animal in a mechanical device or enclosed place or pit.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">piégeage</skos:prefLabel>
      <skos:prefLabel xml:lang="it">caccia con trappole</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">het in klemmen vangen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Einfangen</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
