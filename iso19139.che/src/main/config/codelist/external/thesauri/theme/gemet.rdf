      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15174"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15244">
      <skos:prefLabel xml:lang="en">non-renewable natural resource</skos:prefLabel>
      <skos:scopeNote xml:lang="en">resource that does not renew itself at a sufficient rate for sustainable economic extraction in meaningful human time-frames</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/9"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/31"/>
