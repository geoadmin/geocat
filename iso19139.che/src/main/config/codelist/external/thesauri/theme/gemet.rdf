      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5629"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1191">
      <skos:prefLabel xml:lang="en">carnivore</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An animal that eats meat.</skos:scopeNote>
