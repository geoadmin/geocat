   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11795">
      <skos:prefLabel xml:lang="en">chemical corrosivity</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The tendency of a metal to wear away another by chemical attack.</skos:scopeNote>
