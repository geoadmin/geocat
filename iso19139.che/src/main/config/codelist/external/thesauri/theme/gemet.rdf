      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/38"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/11322"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4635"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/8797"/>
