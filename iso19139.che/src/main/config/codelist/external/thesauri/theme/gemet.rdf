   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1181">
      <skos:prefLabel xml:lang="en">carcinogenicity test</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Test for assessing if a chemical or physical agent increases the risk of cancer. The three major ways of testing for carcinogens are animals tests, epidemiological studies and bacterial tests.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">test de cancérigénicité</skos:prefLabel>
      <skos:prefLabel xml:lang="it">test sulla carcinogenità</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">test van het kankerverwekkend zijn</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Kanzerogenitätsprüfung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/6"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/26"/>
