      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15184"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/363">
      <skos:prefLabel xml:lang="en">amalgam</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A solution of a metal in mercury.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">amalgame</skos:prefLabel>
      <skos:prefLabel xml:lang="it">amalgama</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">amalgaam</skos:prefLabel>
