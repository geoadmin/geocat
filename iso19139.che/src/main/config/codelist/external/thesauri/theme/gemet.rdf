   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1007">
      <skos:prefLabel xml:lang="en">bromine</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A pungent dark red volatile liquid element of the halogen series that occurs in brine and is used in the production of chemicals.</skos:scopeNote>
