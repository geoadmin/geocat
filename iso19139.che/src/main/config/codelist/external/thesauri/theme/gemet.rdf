      <skos:prefLabel xml:lang="it">finanziamento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">financiering</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Finanzierung</skos:prefLabel>
