      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6794"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3196">
      <skos:prefLabel xml:lang="en">financial compensation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The financial reparations that a claimant seeks or a court awards for injuries sustained or property harmed by another.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">dédommagement financier</skos:prefLabel>
      <skos:prefLabel xml:lang="it">risarcimento pecuniario</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">financiële vergoeding</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Finanzielle Entschädigung</skos:prefLabel>
