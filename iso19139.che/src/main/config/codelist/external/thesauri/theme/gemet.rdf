   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10818">
      <skos:prefLabel xml:lang="en">environmental occupation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Gainful employment or job-related activity pertaining to ecological concerns, including the preservation of natural resources and the integrity of the ecosystem.</skos:scopeNote>
