      <skos:prefLabel xml:lang="en">pipe</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A tube made of metal, clay, plastic, wood, or concrete and used to conduct a fluid, gas, or finely divided solid.</skos:scopeNote>
