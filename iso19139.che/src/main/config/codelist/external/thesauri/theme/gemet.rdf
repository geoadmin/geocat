      <skos:prefLabel xml:lang="it">agronomia</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">landbouwkunde</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Agrarwissenschaft</skos:prefLabel>
