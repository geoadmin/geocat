   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9159">
      <skos:prefLabel xml:lang="en">water conservation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The protection, development and efficient management of water resources for beneficial purposes.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">conservation de l'eau</skos:prefLabel>
      <skos:prefLabel xml:lang="it">conservazione delle acque</skos:prefLabel>
