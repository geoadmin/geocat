   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7803">
      <skos:prefLabel xml:lang="en">social medicine</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Medicine as applied to treatment of diseases which occur in certain social groups.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">médecine sociale</skos:prefLabel>
      <skos:prefLabel xml:lang="it">medicina sociale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">sociale geneeskunde</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Sozialmedizin</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/17"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/30"/>
