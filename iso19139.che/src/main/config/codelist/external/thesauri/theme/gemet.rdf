   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4808">
      <skos:prefLabel xml:lang="en">lifestyle</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The particular attitudes, habits or behaviour associated with an individual or group.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">mode de vie</skos:prefLabel>
      <skos:prefLabel xml:lang="it">stile di vita</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">leefwijze</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lebensstil</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/34"/>
      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/10925"/>
