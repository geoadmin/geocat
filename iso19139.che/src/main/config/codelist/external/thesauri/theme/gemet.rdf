      <skos:prefLabel xml:lang="de">Chemische Schädlingsbekämpfung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/2"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3530"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/4354"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6139"/>
