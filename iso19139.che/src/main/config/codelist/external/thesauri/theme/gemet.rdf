   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/12459">
      <skos:prefLabel xml:lang="en">classified facility</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Facility that is forbidden to be disclosed outside a specified ring of secrecy for reasons of national security.</skos:scopeNote>
