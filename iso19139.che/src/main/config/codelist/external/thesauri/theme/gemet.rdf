      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2413"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/14843">
      <skos:prefLabel xml:lang="en">Caspian Sea</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">mer caspienne</skos:prefLabel>
      <skos:prefLabel xml:lang="it">Mar Caspio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">Kaspische Zee</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Kaspisches Meer</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/16"/>
