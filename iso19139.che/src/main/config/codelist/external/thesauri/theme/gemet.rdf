   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2674">
      <skos:prefLabel xml:lang="en">emission source</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A chemical process, building, furnace, plant or other entity responsible for the discharge of pollutants or contaminants into the environment.</skos:scopeNote>
