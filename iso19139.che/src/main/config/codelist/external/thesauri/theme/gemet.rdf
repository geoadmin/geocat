   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11794">
      <skos:prefLabel xml:lang="en">volatile substance</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A substance capable of readily changing from a solid or liquid form to a vapour; having a high vapour pressure and a low boiling point.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">substance volatile</skos:prefLabel>
      <skos:prefLabel xml:lang="it">sostanza volatile</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vluchtige stof</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Flüchtiger Stoff</skos:prefLabel>
