   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6551">
      <skos:prefLabel xml:lang="en">poverty</skos:prefLabel>
      <skos:scopeNote xml:lang="en">State in which the individual lacks the resources necessary for subsistence.</skos:scopeNote>
