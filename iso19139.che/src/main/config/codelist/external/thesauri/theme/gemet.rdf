   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4918">
      <skos:prefLabel xml:lang="en">low-cost housing</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Residences built at minimal expense and designed to keep the rental rate or price of purchase affordable for persons with limited means, usually determined by an annual income level set below the local median.</skos:scopeNote>
