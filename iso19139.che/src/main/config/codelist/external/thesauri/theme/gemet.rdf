   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9052">
      <skos:prefLabel xml:lang="en">waste charge</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Imposed fee, expense, or cost for the management of refuse or unwanted materials left over from a manufacturing process.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">redevance sur les déchêts</skos:prefLabel>
      <skos:prefLabel xml:lang="it">tassa sui rifiuti</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">afvalheffing</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Abfallabgabe</skos:prefLabel>
