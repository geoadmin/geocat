   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6728">
      <skos:prefLabel xml:lang="en">property protection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">That benefit or safety which the government affords to the citizens to insure their individual or corporate right to exclusive enjoyment and disposal of property, money and any other thing tangible or intangible that represents a source of income or wealth.</skos:scopeNote>
