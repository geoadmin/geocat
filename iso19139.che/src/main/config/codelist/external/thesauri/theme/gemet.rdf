      <skos:prefLabel xml:lang="it">classificazione delle imprese</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">bedrijfsclassificatie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Unternehmensarten</skos:prefLabel>
