   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7724">
      <skos:prefLabel xml:lang="en">slaughterhouse</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A place where animals are butchered for food.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">abattoir</skos:prefLabel>
      <skos:prefLabel xml:lang="it">mattatoio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">(openbaar)slachthuis</skos:prefLabel>
