   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15180">
      <skos:prefLabel xml:lang="en">fuel gas</skos:prefLabel>
      <skos:scopeNote xml:lang="en">any one of a number of fuels that under ordinary conditions are gaseous</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/10"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/27"/>
