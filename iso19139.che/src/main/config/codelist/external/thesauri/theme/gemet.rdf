      <skos:prefLabel xml:lang="it">dispositivo di scarico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">uitlaat</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Auspuffanlage</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/3"/>
