      <skos:prefLabel xml:lang="it">diritto di protezione industriale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">industrieel eigendomsrecht</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schutzrecht</skos:prefLabel>
