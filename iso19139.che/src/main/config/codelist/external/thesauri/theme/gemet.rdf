      <skos:prefLabel xml:lang="it">risorse idriche</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">waterbronnen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wasserressourcen</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/31"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/40"/>
