   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1837">
      <skos:prefLabel xml:lang="en">county</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An area comprising more than one city and whose boundaries have been designed according to some biological, political, administrative, economic, demographic criteria.</skos:scopeNote>
