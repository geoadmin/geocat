   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9127">
      <skos:prefLabel xml:lang="en">waste water</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Used water, or water that is not needed, which is permitted to escape, or unavoidably escapes from canals, ditches, reservoirs or other bodies of water, for which the owners of these structures are legally responsible.</skos:scopeNote>
