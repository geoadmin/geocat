   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10064">
      <skos:prefLabel xml:lang="en">wildlife protection</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Precautionary actions, procedures or installations undertaken to prevent or reduce harm to animals, plants and other organisms living in their natural state.</skos:scopeNote>
