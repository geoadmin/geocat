      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/219"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13187">
      <skos:prefLabel xml:lang="en">environmental problem solving</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The activity of finding solutions for troublesome or perplexing situations involving ecological or natural resources.</skos:scopeNote>
