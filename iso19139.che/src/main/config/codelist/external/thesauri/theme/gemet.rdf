      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/5686"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6790">
      <skos:prefLabel xml:lang="en">public domain</skos:prefLabel>
      <skos:scopeNote xml:lang="en">That which can be accessed, used and shared by the general populace without restrictions, penalties or fees.</skos:scopeNote>
