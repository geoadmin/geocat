      <skos:prefLabel xml:lang="fr">droit d'accès</skos:prefLabel>
      <skos:prefLabel xml:lang="it">diritto di passaggio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">openbaarheid</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Zugangsberechtigung</skos:prefLabel>
