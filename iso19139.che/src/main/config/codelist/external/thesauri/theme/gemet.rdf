      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/6395"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5651">
      <skos:prefLabel xml:lang="en">noise pollution</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Harmful or unwanted sounds in the environment, which in specific locals, can be measured and averaged over a period of time.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">pollution sonore de l'environnement</skos:prefLabel>
      <skos:prefLabel xml:lang="it">inquinamento acustico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">geluidshinder</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Lärmbelästigung</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/24"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/26"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/10017"/>
