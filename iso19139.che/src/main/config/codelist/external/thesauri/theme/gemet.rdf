   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7169">
      <skos:prefLabel xml:lang="en">resource appraisal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Assessment of the availability of resources in a given area.</skos:scopeNote>
