   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3044">
      <skos:prefLabel xml:lang="en">exhaust device</skos:prefLabel>
      <skos:scopeNote xml:lang="en">1) A duct or pipe through which waste material is emitted.
2) A combination of components which provides for enclosed flow of exhaust gas from engine parts to the atmosphere.</skos:scopeNote>
