   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8387">
      <skos:prefLabel xml:lang="en">terrestrial biological resource</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any source of supply derived from plants, animals or other wildlife inhabiting land or ground, which may be used by humans for food, clothes and other necessities.</skos:scopeNote>
