   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13205">
      <skos:prefLabel xml:lang="en">root crop</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Plants which store edible material in a root, corm or tuber; root crops used as food vegetables or fodder include carrots, parsnips, swedes and turnips; starchy root crops include potatoes, cassavas and yams.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">plante sarclée</skos:prefLabel>
      <skos:prefLabel xml:lang="it">tuberi da raccolto</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">wortel- en knolgewas</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wurzelgemüse</skos:prefLabel>
