   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4176">
      <skos:prefLabel xml:lang="en">improvement of efficiency</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The beneficial development or progress in the volume of output that is achieved in terms of productivity and input, or in getting the maximum possible output from given or allocated resources.</skos:scopeNote>
