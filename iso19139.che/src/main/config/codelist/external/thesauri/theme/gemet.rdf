   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9063">
      <skos:prefLabel xml:lang="en">waste disposal act</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Law that settles the rules concerning the disposal, recycling and treatment of wastes.</skos:scopeNote>
