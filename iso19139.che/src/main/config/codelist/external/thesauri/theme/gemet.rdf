   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9132">
      <skos:prefLabel xml:lang="en">waste water from trade</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Liquid or waterborne wastes polluted or fouled by commercial operations.</skos:scopeNote>
