   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8629">
      <skos:prefLabel xml:lang="en">transition element</skos:prefLabel>
      <skos:scopeNote xml:lang="en">One of a group of metallic elements in which the members have the filling of the outermost shell to 8 electrons interrupted to bring the penultimate shell from 8 to 18 or 32 electrons; includes elements 21 through 29 (scandium through copper), 39 through 47 (yttrium through silver), 57 through 79 (lanthanum through gold), and all known elements from 89 (actinium) on.</skos:scopeNote>
