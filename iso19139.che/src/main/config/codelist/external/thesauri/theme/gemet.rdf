      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13291"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11535">
      <skos:prefLabel xml:lang="en">state control</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The power or authority of a government to regulate or command industry, organizations, programs, initiatives and individuals.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">contrôle d'état</skos:prefLabel>
      <skos:prefLabel xml:lang="it">controllo statale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">staatscontrole</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Staatliche Kontrolle</skos:prefLabel>
