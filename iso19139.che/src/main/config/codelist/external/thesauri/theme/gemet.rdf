      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3381"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3388"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/3953"/>
