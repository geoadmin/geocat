   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9136">
      <skos:prefLabel xml:lang="en">waste water purification</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Processing of waste water for reuse.</skos:scopeNote>
