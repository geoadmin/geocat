   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10066">
      <skos:prefLabel xml:lang="en">historic centre</skos:prefLabel>
      <skos:scopeNote xml:lang="en">That part of a town or city in which the principal public and historic buildings are located.</skos:scopeNote>
