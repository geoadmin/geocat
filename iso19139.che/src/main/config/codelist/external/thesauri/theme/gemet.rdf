      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/5820"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4234">
      <skos:prefLabel xml:lang="en">industrial equipment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Equipment related to industrial activities.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">équipement industriel</skos:prefLabel>
      <skos:prefLabel xml:lang="it">apparecchiatura industriale</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">industriële uitrusting</skos:prefLabel>
