   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11530">
      <skos:prefLabel xml:lang="en">public benefit inquiry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An investigation, especially a formal one conducted into a matter of public utility by a body constituted for that purpose by a government, local authority, or other organization.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">enquête d'utilité publique</skos:prefLabel>
