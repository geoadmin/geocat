      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2774"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11063">
      <skos:prefLabel xml:lang="en">water cost</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The value or the amount of money exchanged for the production and sustained supply of water.</skos:scopeNote>
