   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11276">
      <skos:prefLabel xml:lang="en">railway network</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The whole system of railway distribution in a country.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">réseau ferroviaire</skos:prefLabel>
