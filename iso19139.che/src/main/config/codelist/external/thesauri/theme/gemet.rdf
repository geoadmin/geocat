      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/415"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10539">
      <skos:prefLabel xml:lang="en">animal population</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A group of animals inhabiting a given area.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">population animale</skos:prefLabel>
