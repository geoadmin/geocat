      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15194"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15313"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15044">
      <skos:prefLabel xml:lang="en">above-ground tree biomass</skos:prefLabel>
      <skos:scopeNote xml:lang="en">all living matter composed of trees defined as generally five cm or greater diameter at breast height (4.3 feet above ground)</skos:scopeNote>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/883"/>
