   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/81">
      <skos:prefLabel xml:lang="en">adaptable species</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">espèce capable de s'adapter</skos:prefLabel>
      <skos:prefLabel xml:lang="it">specie adattabile</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">soorten met aanpassingsvermogen</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Anpassungsfähige Art</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/4"/>
