   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11198">
      <skos:prefLabel xml:lang="en">breeding technique</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Term referring to the systems employed in animal rearing (extensive and intensive).</skos:scopeNote>
