   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2740">
      <skos:prefLabel xml:lang="en">energy saving</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Avoiding wasting energy.</skos:scopeNote>
