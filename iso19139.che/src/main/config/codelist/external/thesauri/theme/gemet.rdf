   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2568">
      <skos:prefLabel xml:lang="en">research of the effects</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Investigation carried out to assess the results deriving from an action or condition; general term applying to many different fields.</skos:scopeNote>
