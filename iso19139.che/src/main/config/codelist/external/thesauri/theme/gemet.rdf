      <skos:prefLabel xml:lang="it">prova tossicologica</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">giftigheidsonderzoek</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Toxikologische Untersuchung</skos:prefLabel>
