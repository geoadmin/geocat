      <skos:prefLabel xml:lang="it">deprezzamento agricolo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">landbouwkundige onderwaardering</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Landwirtschaftliche Unterbewertung</skos:prefLabel>
