   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/566">
      <skos:prefLabel xml:lang="en">arrangement for a deposit on packaging</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Agreement to provide refunds or payments in exchange for used bottles or packaging materials.</skos:scopeNote>
