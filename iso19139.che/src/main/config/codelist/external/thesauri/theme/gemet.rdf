      <skos:prefLabel xml:lang="en">concrete products industry</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">industrie du béton</skos:prefLabel>
      <skos:prefLabel xml:lang="it">industria dei manufatti di calcestruzzo</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">betonnijverheid</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Betonsteinindustrie</skos:prefLabel>
