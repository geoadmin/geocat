   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10068">
      <skos:prefLabel xml:lang="en">masonry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A construction of stone or similar materials such as concrete or brick.</skos:scopeNote>
