   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4169">
      <skos:prefLabel xml:lang="en">import licence</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Permission from a government to bring within its borders and sell a product manufactured in a foreign country.</skos:scopeNote>
