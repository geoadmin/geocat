      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/9062"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11771">
      <skos:prefLabel xml:lang="en">biological test</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The laboratory determination of the effects of substances upon specific living organisms.</skos:scopeNote>
