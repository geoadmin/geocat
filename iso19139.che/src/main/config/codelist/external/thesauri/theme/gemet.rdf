   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6084">
      <skos:prefLabel xml:lang="en">peat extraction</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Peat is obtained from peat bogs by cutting it from the earth; it is then formed into briquettes, which can be used as fuel. Peat may be found in layers several metres thick. In some countries peat-fired generating stations for electricity are in use. Peat is also used as a soil conditioner.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">extraction de tourbe</skos:prefLabel>
      <skos:prefLabel xml:lang="it">estrazione di torba</skos:prefLabel>
