      <skos:prefLabel xml:lang="nl">openbaar gebouw</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Öffentliches Gebäude</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/5"/>
