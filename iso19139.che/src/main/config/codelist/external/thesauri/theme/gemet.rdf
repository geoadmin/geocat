   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9221">
      <skos:prefLabel xml:lang="en">water resource</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Water in any of its forms, wherever located - atmosphere, surface or ground - which is or can be of value to man.</skos:scopeNote>
