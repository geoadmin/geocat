   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8720">
      <skos:prefLabel xml:lang="en">twin-hull craft</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Oil tank vessels provided with a double-hull to meet the regulatory safety requirements in oil transportation. Requirements include minimum values for depths and breadth of double bottoms. Also called double-hull tank vessel.</skos:scopeNote>
