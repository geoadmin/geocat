      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/698"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/311">
      <skos:prefLabel xml:lang="en">aliphatic compound</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any organic compound of hydrogen and carbon characterized by a straight chain of the carbon atoms.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">composés aliphatiques</skos:prefLabel>
      <skos:prefLabel xml:lang="it">composto alifatico</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">alifatische verbinding</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Aliphatische Verbindungen</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/6"/>
