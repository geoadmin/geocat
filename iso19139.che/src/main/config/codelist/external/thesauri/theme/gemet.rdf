   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3343">
      <skos:prefLabel xml:lang="en">foaming agent</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Substances which make it possible to form a homogenous dispersion of a gaseous phase in a liquid or solid medium.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">agent moussant</skos:prefLabel>
      <skos:prefLabel xml:lang="it">agente schiumogeno</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">schuimmiddel</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schaumbildner</skos:prefLabel>
