      <skos:prefLabel xml:lang="it">licenza di importazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">invoervergunning</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Einfuhrlizenz</skos:prefLabel>
