   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11498">
      <skos:prefLabel xml:lang="en">technical instruction</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The education, instruction, or discipline pertaining to or connected with the mechanical or industrial arts and the applied sciences.</skos:scopeNote>
