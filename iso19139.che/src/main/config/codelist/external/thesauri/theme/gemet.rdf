   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6552">
      <skos:prefLabel xml:lang="en">power company</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Company which is responsible for the supply and distribution of electric energy to a given area.</skos:scopeNote>
