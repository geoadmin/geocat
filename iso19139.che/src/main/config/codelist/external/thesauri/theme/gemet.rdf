   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4186">
      <skos:prefLabel xml:lang="en">slope</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The inclined surface of any part of the Earth's surface, as a hillslope; also, a broad part of a continent descending toward an ocean, as the Pacific slope.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">pente</skos:prefLabel>
      <skos:prefLabel xml:lang="it">pendio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">helling</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Hang</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/16"/>
