   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4567">
      <skos:prefLabel xml:lang="en">laboratory</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A room or building with scientific equipment for doing scientific tests or for teaching science, or a place where chemicals or medicines are produced.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">laboratoire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">laboratorio</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">laboratorium</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Laboratorium</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/5"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/30"/>
