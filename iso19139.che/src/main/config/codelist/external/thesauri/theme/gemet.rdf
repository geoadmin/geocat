   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9389">
      <skos:prefLabel xml:lang="en">write-off</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Accounting procedure that is used when an asset is uncollectible and is therefore charged-off as a loss.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">écriture d'annulation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">deprezzamento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">afschrijven</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Abschreibung</skos:prefLabel>
