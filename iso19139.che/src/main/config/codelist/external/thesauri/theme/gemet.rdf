   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4668">
      <skos:prefLabel xml:lang="en">landslide</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Mass-movement landforms and processes involving the downslope transport, under gravitationary influence of soil and rock material en masse.</skos:scopeNote>
