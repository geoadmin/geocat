      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/39"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/7621"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7114">
      <skos:prefLabel xml:lang="en">replacement</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Substitution of an atom or atomic group with a different one.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">substitution</skos:prefLabel>
      <skos:prefLabel xml:lang="it">sostituzione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">vervanging</skos:prefLabel>
