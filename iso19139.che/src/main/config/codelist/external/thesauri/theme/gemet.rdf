   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/250">
      <skos:prefLabel xml:lang="en">air conditioning</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A system or process for controlling the temperature and sometimes the humidity and purity of the air in a house, etc.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">climatisation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">condizionamento dell'aria</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">luchtverversing</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Klimatisierung</skos:prefLabel>
