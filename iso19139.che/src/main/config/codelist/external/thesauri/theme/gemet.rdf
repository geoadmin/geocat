   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5791">
      <skos:prefLabel xml:lang="en">ocean circulation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Water current flow in a closed circular pattern within an ocean.</skos:scopeNote>
