      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/6627"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6631">
      <skos:prefLabel xml:lang="en">prior informed consent</skos:prefLabel>
