      <skos:prefLabel xml:lang="fr">investissement</skos:prefLabel>
      <skos:prefLabel xml:lang="it">investimento</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">investering</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Investition</skos:prefLabel>
