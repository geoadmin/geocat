   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2339">
      <skos:prefLabel xml:lang="en">drinking water</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Water that is agreeable to drink, does not present health hazards and whose quality is normally regulated by legislation.</skos:scopeNote>
