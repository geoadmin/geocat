   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6536">
      <skos:prefLabel xml:lang="en">post-treatment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Treatment of treated water or wastewater to improve the water quality.</skos:scopeNote>
