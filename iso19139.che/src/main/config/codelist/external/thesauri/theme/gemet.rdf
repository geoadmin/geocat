   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7021">
      <skos:prefLabel xml:lang="en">recycling potential</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">potentiel de recyclage</skos:prefLabel>
