   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9139">
      <skos:prefLabel xml:lang="en">waste water reduction</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The act or process of lessening the volume of used or spent water that is discharged from homes, businesses or industries.</skos:scopeNote>
