      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/3698"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4957">
      <skos:prefLabel xml:lang="en">macroeconomics</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Modern economic analysis that is concerned with data inaggregate as opposed to individual form such as national income, consumption and investment.</skos:scopeNote>
