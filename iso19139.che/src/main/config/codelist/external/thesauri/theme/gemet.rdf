      <skos:prefLabel xml:lang="it">qualità dell'acqua</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">waterkwaliteit</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Wassergüte</skos:prefLabel>
