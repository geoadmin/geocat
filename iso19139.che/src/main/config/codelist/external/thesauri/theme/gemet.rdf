      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/13290"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11514">
      <skos:prefLabel xml:lang="en">regulation</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The act of regulating; a rule or order prescribed for management or government; a regulating principle; a precept. Rule of order prescribed by superior or competent authority relating to action on those under its control.</skos:scopeNote>
