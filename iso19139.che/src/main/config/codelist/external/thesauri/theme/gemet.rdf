   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5203">
      <skos:prefLabel xml:lang="en">methodology</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The system of methods and principles used in a particular discipline.</skos:scopeNote>
