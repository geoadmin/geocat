      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/2656"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9035">
      <skos:prefLabel xml:lang="en">warning system</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any series of procedures and devices designed to detect sudden or potential threats to persons, property or the environment, often utilizing radar technology.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">système d'alerte</skos:prefLabel>
      <skos:prefLabel xml:lang="it">sistema di allarme</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">alarmsysteem</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Warnsystem</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/32"/>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/10054"/>
