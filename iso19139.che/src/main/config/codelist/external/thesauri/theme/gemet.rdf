      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/4279"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8422">
      <skos:prefLabel xml:lang="en">textile</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A material made of natural or man-made fibers and used for the manufacture of items such as clothing and furniture fittings.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">textile</skos:prefLabel>
      <skos:prefLabel xml:lang="it">prodotto tessile</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">textiel</skos:prefLabel>
