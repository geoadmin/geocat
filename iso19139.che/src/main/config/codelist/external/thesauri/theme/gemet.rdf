   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13212">
      <skos:prefLabel xml:lang="en">coal industry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Industry related with the technical and mechanical activity of removing coal from the earth and preparing it for market.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">industrie charbonnière</skos:prefLabel>
      <skos:prefLabel xml:lang="it">industria del carbone</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">steenkoolindustrie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Kohlenindustrie</skos:prefLabel>
