   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8650">
      <skos:prefLabel xml:lang="en">transport (physics)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Transfer of mass, momentum, or energy in a system as a result of molecular agitation, including such properties as thermal conduction and viscosity.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">transport (physique)</skos:prefLabel>
      <skos:prefLabel xml:lang="it">trasporto (fisica)</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">overbrenging</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Transport (physikalisch)</skos:prefLabel>
