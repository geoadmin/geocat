   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11706">
      <skos:prefLabel xml:lang="en">observation satellite</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Man-made device that orbits the earth, receiving, processing and transmitting signals and generating images such as weather pictures.</skos:scopeNote>
