   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/10274">
      <skos:prefLabel xml:lang="en">public awareness campaign</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An organized, systematic effort through various communications media to alert the general population of a given area to anything of significant interest or concern.</skos:scopeNote>
