      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/48"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/470">
      <skos:prefLabel xml:lang="en">anthropogenic factor</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">facteur anthropique</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fattori antropogeni</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">antropogene factor</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Anthropogener Faktor</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/15"/>
