   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7115">
      <skos:prefLabel xml:lang="en">replacement cost</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The amount of money involved to replace or have an item take the place of another item.</skos:scopeNote>
