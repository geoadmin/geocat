   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13184">
      <skos:prefLabel xml:lang="en">environmental economics of firms</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The use of financial resources for the purpose of incorporating ecological principles in the operations of businesses and companies.</skos:scopeNote>
