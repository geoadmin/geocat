   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/135">
      <skos:prefLabel xml:lang="en">aerial photograph</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An image of the ground surface made on a light-sensitive material and taken at a high altitude from an aircraft, spacecraft or rocket.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">photographie aérienne</skos:prefLabel>
      <skos:prefLabel xml:lang="it">fotografia aerea (immagine)</skos:prefLabel>
