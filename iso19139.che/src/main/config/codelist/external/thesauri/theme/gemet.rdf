      <skos:prefLabel xml:lang="nl">slachtdier</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Schlachtvieh</skos:prefLabel>
      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/theme/2"/>
