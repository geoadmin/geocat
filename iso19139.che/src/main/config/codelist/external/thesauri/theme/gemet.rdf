   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4171">
      <skos:prefLabel xml:lang="en">impoverishment</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">appauvrissement</skos:prefLabel>
