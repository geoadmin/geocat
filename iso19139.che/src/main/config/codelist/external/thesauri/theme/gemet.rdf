   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13210">
      <skos:prefLabel xml:lang="en">fisheries structure</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Refers to all the structures (fishing vessels, trawling nets, factory ships, catcher boats, etc.) used in fishing industry.</skos:scopeNote>
