   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8025">
      <skos:prefLabel xml:lang="en">spring (hydrology, land)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A place where ground water flows naturally from a rock or the soil onto the land surface or into a body of surface water.</skos:scopeNote>
