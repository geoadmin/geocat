   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6867">
      <skos:prefLabel xml:lang="en">quarry</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An open or surface working or excavation for the extraction of building stone, ore, coal, gravel, or minerals.</skos:scopeNote>
