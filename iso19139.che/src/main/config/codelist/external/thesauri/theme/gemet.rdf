   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8149">
      <skos:prefLabel xml:lang="en">structure-borne noise</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Sound that travels over at least part of its path by means of the vibration of a solid structure.</skos:scopeNote>
