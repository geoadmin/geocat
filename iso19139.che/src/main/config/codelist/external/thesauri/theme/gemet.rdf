      <skos:prefLabel xml:lang="it">procedura delle udienze</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">hoorzitting</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Anhörungsverfahren</skos:prefLabel>
