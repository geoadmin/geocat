   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5350">
      <skos:prefLabel xml:lang="en">monitoring network</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Interconnected group of monitoring stations for the surveillance of pollution.</skos:scopeNote>
