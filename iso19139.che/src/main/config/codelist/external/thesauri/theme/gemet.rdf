      <skos:prefLabel xml:lang="it">incidente sul lavoro</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">bedrijfsongeluk</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Arbeitsunfall</skos:prefLabel>
