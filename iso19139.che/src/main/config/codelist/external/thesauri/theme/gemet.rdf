   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11065">
      <skos:prefLabel xml:lang="en">ecomarketing</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The buying, selling, advertising, shipping, and storing of goods in compliance with ecological principles.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">écomarketing</skos:prefLabel>
      <skos:prefLabel xml:lang="it">ecomarketing</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">milieumarketing</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Ökomarketing</skos:prefLabel>
