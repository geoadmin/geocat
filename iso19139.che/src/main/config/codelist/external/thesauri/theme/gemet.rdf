   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13186">
      <skos:prefLabel xml:lang="en">yield (agricultural)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The accumulated volume or biomass remaining from gross production after accounting for losses due to respiration during production, herbivory, litterfall, and other factors that decrease the remaining available biomass.</skos:scopeNote>
