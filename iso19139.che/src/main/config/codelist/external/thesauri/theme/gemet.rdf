      <skos:prefLabel xml:lang="fr">décision communautaire</skos:prefLabel>
      <skos:prefLabel xml:lang="it">decisione comunitaria</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">gemeenschapswetgeving</skos:prefLabel>
