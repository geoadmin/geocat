   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1314">
      <skos:prefLabel xml:lang="en">chemical pest control</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Control of plants and animals classified as pests by means of chemical compounds.</skos:scopeNote>
