   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7172">
      <skos:prefLabel xml:lang="en">resource exploitation</skos:prefLabel>
      <skos:prefLabel xml:lang="fr">exploitation des ressources</skos:prefLabel>
