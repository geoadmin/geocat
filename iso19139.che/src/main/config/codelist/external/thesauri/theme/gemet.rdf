      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/8312"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3201">
      <skos:prefLabel xml:lang="en">financial market</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A place or institution in which buyers and sellers meet and trade monetary assets, including stocks, bonds, securities and money.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">marché financier</skos:prefLabel>
      <skos:prefLabel xml:lang="it">mercato finanziario</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">financiële markt</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Finanzmarkt</skos:prefLabel>
