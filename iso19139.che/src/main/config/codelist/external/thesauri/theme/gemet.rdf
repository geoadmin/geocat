   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1724">
      <skos:prefLabel xml:lang="en">construction noise</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Noise resulting from construction activities such as site preparation, site clearance, demolition of existing buildings, piling, concreting, erection of structures, etc.</skos:scopeNote>
