      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/976"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6270">
      <skos:prefLabel xml:lang="en">pipeline</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A line of pipe connected to valves and other control devices, for conducting fluids, gases, or finely divided solids.</skos:scopeNote>
