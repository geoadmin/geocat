      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/1911"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5362">
      <skos:prefLabel xml:lang="en">moor</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A tract of unenclosed waste ground, usually covered with heather, coarse grass, bracken, and moss.</skos:scopeNote>
