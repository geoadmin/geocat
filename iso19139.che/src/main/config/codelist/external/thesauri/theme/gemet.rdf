   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/654">
      <skos:prefLabel xml:lang="en">attribution</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Under certain circumstances, the tax law applies attribution rules to assign to one taxpayer the ownership interest of another taxpayer.</skos:scopeNote>
