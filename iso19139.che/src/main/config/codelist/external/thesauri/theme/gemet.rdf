   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/11869">
      <skos:prefLabel xml:lang="en">plant biology</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The scientific study of the natural processes of plants.</skos:scopeNote>
