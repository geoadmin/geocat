   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4577">
      <skos:prefLabel xml:lang="en">labour</skos:prefLabel>
      <skos:scopeNote xml:lang="en">One of the factors of production. It includes all the exertions - manual, physical or mental - by individuals, directed towards the production of wealth.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">travail</skos:prefLabel>
      <skos:prefLabel xml:lang="it">lavoro</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">arbeid</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Arbeit</skos:prefLabel>
