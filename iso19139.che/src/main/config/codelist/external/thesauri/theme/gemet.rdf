   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6527">
      <skos:prefLabel xml:lang="en">population structure</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The organization of, and inter-relationships among, inhabitants of a given region, country or city.</skos:scopeNote>
