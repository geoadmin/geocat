   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9371">
      <skos:prefLabel xml:lang="en">working hours</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The time devoted to gainful employment or job-related activities, usually calculated as hours per day or per week.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">heures de travail</skos:prefLabel>
      <skos:prefLabel xml:lang="it">orario di lavoro</skos:prefLabel>
