   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1469">
      <skos:prefLabel xml:lang="en">climate type</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Weather conditions typical of areas roughly corresponding to lines of latitude.</skos:scopeNote>
