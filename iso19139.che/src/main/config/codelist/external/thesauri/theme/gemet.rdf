      <skos:narrower rdf:resource="http://www.eionet.europa.eu/gemet/concept/9327"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5197">
      <skos:prefLabel xml:lang="en">meteorology</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The science concerned with the atmosphere and its phenomena.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">météorologie</skos:prefLabel>
      <skos:prefLabel xml:lang="it">meteorologia</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">weerkunde</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Meteorologie</skos:prefLabel>
