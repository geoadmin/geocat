   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/521">
      <skos:prefLabel xml:lang="en">arable farming</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Growing crops as opposed to dairy farming, cattle farming, etc.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">culture de champ</skos:prefLabel>
      <skos:prefLabel xml:lang="it">coltura dei campi</skos:prefLabel>
