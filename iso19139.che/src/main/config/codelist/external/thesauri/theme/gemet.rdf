      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/5913"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7156"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7328"/>
      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/7920"/>
