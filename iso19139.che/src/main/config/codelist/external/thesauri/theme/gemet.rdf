   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/2084">
      <skos:prefLabel xml:lang="en">deposition</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process by which polluting material is precipitated from the atmosphere and accumulates in ecosystems.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">rétombée atmosphérique</skos:prefLabel>
