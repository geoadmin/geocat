      <skos:related rdf:resource="http://www.eionet.europa.eu/gemet/concept/15210"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9135">
      <skos:prefLabel xml:lang="en">waste water load</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The amount of spent or used water, often containing dissolved and suspended matter, that is found in a stream or some other body of water.</skos:scopeNote>
