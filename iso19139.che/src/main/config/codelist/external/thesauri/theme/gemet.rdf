   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3022">
      <skos:prefLabel xml:lang="en">evapotranspiration</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Discharge of water from the earth's surface to the atmosphere by evaporation from lakes, streams and soil surfaces and by transpiration from plants. Also known as fly-off.</skos:scopeNote>
