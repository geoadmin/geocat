   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13220">
      <skos:prefLabel xml:lang="en">military equipment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Equipment necessary to the performance of military activities, either combat or noncombat.</skos:scopeNote>
