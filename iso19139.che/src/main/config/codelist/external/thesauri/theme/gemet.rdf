      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/8415"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/841">
      <skos:prefLabel xml:lang="en">biological analysis</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The analysis of a substance in order to ascertain its influence on living organisms.</skos:scopeNote>
