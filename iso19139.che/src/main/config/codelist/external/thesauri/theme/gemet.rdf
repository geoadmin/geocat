      <skos:prefLabel xml:lang="en">toxicological assessment</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The process of characterizing and evaluating the inherent toxicity of a chemical substance, a poison, etc.</skos:scopeNote>
