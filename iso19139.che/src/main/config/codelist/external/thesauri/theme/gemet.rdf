      <skos:prefLabel xml:lang="en">plain</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An extensive, broad tract of level or rolling, almost treeless land with a shrubby vegetation, usually at a low elevation.</skos:scopeNote>
