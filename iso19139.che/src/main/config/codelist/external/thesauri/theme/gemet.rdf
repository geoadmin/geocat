   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9125">
      <skos:prefLabel xml:lang="en">waste use</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The incorporation of wastes into natural or artificial cycles, mainly in order to recover secondary raw materials or energy.</skos:scopeNote>
