   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/7036">
      <skos:prefLabel xml:lang="en">refining</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The processing of raw material to remove impurities.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">raffinage</skos:prefLabel>
      <skos:prefLabel xml:lang="it">raffinazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">raffineren</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Raffination</skos:prefLabel>
