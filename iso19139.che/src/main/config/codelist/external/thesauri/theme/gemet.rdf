   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/13576">
      <skos:prefLabel xml:lang="en">eco-balance</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An eco-balance refers to the consumption of energy and resources and the pollution caused by the production cycle of a given product. The product is followed throughout its entire life cycle, from the extraction of the raw materials, manufacturing and use, right through to recycling and final handling of waste.</skos:scopeNote>
