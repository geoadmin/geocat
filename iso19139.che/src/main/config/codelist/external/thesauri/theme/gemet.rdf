   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/319">
      <skos:prefLabel xml:lang="en">alkali soil</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Soil that contains sufficient exchangeable sodium to interfere with water penetration and crop growth, either with or without appreciable quantities of soluble salts.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">sol alcalin</skos:prefLabel>
      <skos:prefLabel xml:lang="it">suoli alcalini</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">alkalische bodem</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Alkalischer Boden</skos:prefLabel>
