   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8004">
      <skos:prefLabel xml:lang="en">spoil dump</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Place where rubbish and waste minerals dug out of a mine are deposited.</skos:scopeNote>
