   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1064">
      <skos:prefLabel xml:lang="en">built structure</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Any structure made of stone, bricks, wood, concrete, or steel, built with a roof and walls, such as a house or factory.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">structure bâtie</skos:prefLabel>
      <skos:prefLabel xml:lang="it">struttura edificata</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">bouwstructuur</skos:prefLabel>
