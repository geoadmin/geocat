   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4956">
      <skos:prefLabel xml:lang="en">macroeconomic goal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">An aim or objective pertaining to the production, distribution and use of income, wealth and commodities in a country, region or other large area, typically concerned with governmental fiscal and monetary policy as it affects employment, consumption, investment and growth levels.</skos:scopeNote>
