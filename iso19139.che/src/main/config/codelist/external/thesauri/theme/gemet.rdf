   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/8540">
      <skos:prefLabel xml:lang="en">toxic metal</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Metals (usually heavy metals) which interfere with the respiration, metabolism or growth of organisms.</skos:scopeNote>
