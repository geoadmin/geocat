      <skos:broader rdf:resource="http://www.eionet.europa.eu/gemet/concept/873"/>
   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/4451">
      <skos:prefLabel xml:lang="en">interpretation method</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Method employed in the assessment of the meaning and significance of data, results, facts, etc.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">méthode d'interprétation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">metodo di interpretazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">interpretatiemethode</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Auswertungsverfahren</skos:prefLabel>
