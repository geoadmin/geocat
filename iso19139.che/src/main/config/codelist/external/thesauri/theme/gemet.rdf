   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/3183">
      <skos:prefLabel xml:lang="en">film</skos:prefLabel>
      <skos:scopeNote xml:lang="en">A motion picture; a thin flexible strip of cellulose coated with a photographic emission, used to make negatives and transparencies.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">film</skos:prefLabel>
      <skos:prefLabel xml:lang="it">film</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">film</skos:prefLabel>
