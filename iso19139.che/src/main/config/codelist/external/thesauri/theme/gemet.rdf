   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/9144">
      <skos:prefLabel xml:lang="en">waste water treatment plant</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Plant where, through physical-chemical and biological processes, organic matter, bacteria, viruses and solids are removed from residential, commercial and industrial wastewaters before they are discharged in rivers, lakes and seas.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">station d'épuration des eaux usées</skos:prefLabel>
