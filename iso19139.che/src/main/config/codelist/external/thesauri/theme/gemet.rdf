   </skos:Concept>
   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/1681">
      <skos:prefLabel xml:lang="en">condensation (process)</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Transformation from a gas to a liquid.</skos:scopeNote>
      <skos:prefLabel xml:lang="fr">condensation</skos:prefLabel>
      <skos:prefLabel xml:lang="it">condensazione</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">condensatie</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Kondensation</skos:prefLabel>
