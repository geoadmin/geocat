      <skos:prefLabel xml:lang="it">zona industriale abbandonata</skos:prefLabel>
      <skos:prefLabel xml:lang="nl">industriële woestenij</skos:prefLabel>
      <skos:prefLabel xml:lang="de">Industriebrachland</skos:prefLabel>
