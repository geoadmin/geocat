   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/6035">
      <skos:prefLabel xml:lang="en">parasite</skos:prefLabel>
      <skos:scopeNote xml:lang="en">Organism which lives and obtains food at the expense of another organism, the host.</skos:scopeNote>
