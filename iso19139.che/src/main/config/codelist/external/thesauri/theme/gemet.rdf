   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/5230">
      <skos:prefLabel xml:lang="en">microscopy</skos:prefLabel>
      <skos:scopeNote xml:lang="en">The interpretative application of microscope magnification to the study of materials that cannot be properly seen by the unaided eye.</skos:scopeNote>
