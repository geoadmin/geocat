   <skos:Concept rdf:about="http://www.eionet.europa.eu/gemet/concept/15227">
      <skos:prefLabel xml:lang="en">marine gas oil</skos:prefLabel>
      <skos:scopeNote xml:lang="en">obtained from the atmospheric distillate of crude and designed to be used in diesel engines which operate under high performance conditions in altitudes under 2000 meters above sea level to generate electric and mechanical power in burners, furnaces, boilers and marine engines</skos:scopeNote>
